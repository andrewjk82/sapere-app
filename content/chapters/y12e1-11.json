        {
          "id": "ascham2020e1-q9",
          "type": "mc",
          "difficulty": "medium",
          "timeLimit": 60,
          "stem": "The graph of the function \\(y=\\cos^{-1}(2x)\\) is dilated horizontally by a dilation factor of 4 and then translated vertically by 3 units. What is its new equation?",
          "hint": "Horizontal dilation factor k: x → x/k. Vertical translation: add outside the function.",
          "steps": [
            {
              "explain": "A horizontal dilation by factor 4 replaces \\(x\\) by \\(\\frac{x}{4}\\).",
              "work": "\\(y=\\cos^{-1}\\left(2\\cdot\\frac{x}{4}\\right)=\\cos^{-1}\\left(\\frac{2x}{4}\\right)\\)"
            },
            {
              "explain": "A vertical translation by 3 adds 3 to the whole function.",
              "work": "\\(y=\\cos^{-1}\\left(\\frac{2x}{4}\\right)+3\\)"
            },
            {
              "explain": "Multiplying \\(x\\) by 4 (option C) would compress the graph, not stretch it; adding 3 inside the brackets is a horizontal shift."
            }
          ],
          "xp": 1,
          "meta": {
            "source": "Ascham 2020 3U Trial",
            "examPaper": "Ascham 2020 3U Trial & Solutions",
            "school": "Ascham",
            "year": 2020,
            "number": "9"
          },
          "options": [
            "\\(y=\\cos^{-1}\\left(\\frac{2x}{4}+3\\right)\\)",
            "\\(y=\\cos^{-1}\\left(\\frac{2x}{4}\\right)+3\\)",
            "\\(y=\\cos^{-1}(8x)+3\\)",
            "\\(y=\\cos^{-1}(8x+3)\\)"
          ],
          "answer": 1,
          "keyPoints": [
            {
              "text": "dilated horizontally by a dilation factor of 4",
              "note": "Replace x by x/4 (not 4x), then add 3 outside the inverse cosine."
            }
          ]
        },
