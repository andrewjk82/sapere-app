            "\\(36\\text{ m}\\)",
            "\\(0.36\\text{ m}\\)",
            "\\(45\\text{ m}\\)",
            "\\(3.6\\text{ m}\\)"
          ],
          "answer": 3,
          "hint": "Multiply the number of stones by the length of each, then convert to metres.",
          "steps": [
            {
              "explain": "Multiply the number of stones by the length of one stone.",
              "work": "\\(8\\times45=360\\text{ cm}\\)"
            },
            {
              "explain": "Convert centimetres to metres by dividing by 100.",
              "work": "\\(360\\div100=3.6\\text{ m}\\)"
            }
          ],
          "xp": 2
        }
