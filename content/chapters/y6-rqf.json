    {
      "topicId": "y6-rqf-4",
      "code": "MA3-RQF-02",
      "title": "Fractions as division",
      "questions": [
        {
          "id": "y6-rqf-4-q1",
          "type": "mc",
          "difficulty": "medium",
          "stem": "The fraction \\(\\dfrac{3}{4}\\) represents which division, and what is its decimal value?",
          "options": [
            "\\(3\\div4=0.75\\)",
            "\\(4\\div3=1.33\\)",
            "\\(3\\times4=12\\)",
            "\\(3+4=7\\)"
          ],
          "answer": 0,
          "hint": "A fraction \\(\\dfrac{a}{b}\\) represents \\(a\\div b\\).",
          "steps": [
            {
              "explain": "A fraction \\(\\dfrac{a}{b}\\) means \\(a\\) divided by \\(b\\).",
              "work": "\\(\\dfrac34 = 3\\div4\\)"
            },
            {
              "explain": "Evaluate the division.",
              "work": "\\(3\\div4=0.75\\)"
            }
          ]
        },
        {
          "id": "y6-rqf-4-q2",
          "type": "mc",
          "difficulty": "hard",
          "stem": "If \\(\\dfrac{2}{5}\\) of a number is \\(20\\), what is the number?",
          "options": [
            "\\(50\\)",
            "\\(40\\)",
            "\\(8\\)",
            "\\(100\\)"
          ],
          "answer": 0,
          "hint": "Find one fifth first (divide by 2), then multiply by 5 to find the whole.",
          "steps": [
            {
              "explain": "Since \\(\\dfrac25\\) of the number is 20, find one fifth by dividing by 2.",
              "work": "\\(20\\div2=10\\) (one fifth)"
            },
            {
              "explain": "Multiply by 5 to find the whole number (five fifths).",
              "work": "\\(10\\times5=50\\)"
            }
          ]
        }
      ]
    },
    {
      "topicId": "y6-rqf-5",
      "code": "MA3-RQF-01",
      "title": "Simplify fractions",
      "questions": [
        {
          "id": "y6-rqf-5-q1",
          "type": "mc",
          "difficulty": "easy",
          "stem": "Simplify \\(\\dfrac{12}{18}\\) to its lowest terms.",
          "options": [
            "\\(\\dfrac{2}{3}\\)",
            "\\(\\dfrac{6}{9}\\)",
            "\\(\\dfrac{4}{6}\\)",
            "\\(\\dfrac{1}{2}\\)"
          ],
          "answer": 0,
          "hint": "Find the highest common factor of 12 and 18.",
          "steps": [
            {
              "explain": "The highest common factor of 12 and 18 is 6.",
              "work": "\\(\\text{HCF}(12,18)=6\\)"
            },
            {
              "explain": "Divide the numerator and denominator by 6.",
              "work": "\\(\\dfrac{12\\div6}{18\\div6}=\\dfrac{2}{3}\\)"
            }
          ]
        },
        {
          "id": "y6-rqf-5-q2",
          "type": "mc",
          "difficulty": "medium",
          "stem": "Simplify \\(\\dfrac{15}{20}\\) to its lowest terms.",
          "options": [
            "\\(\\dfrac{3}{4}\\)",
            "\\(\\dfrac{5}{10}\\)",
            "\\(\\dfrac{1}{2}\\)",
            "\\(\\dfrac{15}{20}\\) (already simplest)"
          ],
          "answer": 0,
          "hint": "Find the highest common factor of 15 and 20.",
          "steps": [
            {
              "explain": "The highest common factor of 15 and 20 is 5.",
              "work": "\\(\\text{HCF}(15,20)=5\\)"
            },
            {
              "explain": "Divide the numerator and denominator by 5.",
              "work": "\\(\\dfrac{15\\div5}{20\\div5}=\\dfrac{3}{4}\\)"
            }
          ]
        }
      ]
    }
