  "year": "Year 6",
  "topics": [
    {
      "topicId": "y6-rqf-1",
      "code": "MA3-RQF-01",
      "title": "Compare fractions (different denominators)",
      "questions": [
        {
          "id": "y6-rqf-1-q1",
          "type": "mc",
          "difficulty": "easy",
          "stem": "Which fraction is greater: \\(\\dfrac{3}{4}\\) or \\(\\dfrac{5}{6}\\)?",
          "options": [
            "\\(\\dfrac{3}{4}\\)",
            "\\(\\dfrac{5}{6}\\)",
            "They are equal",
            "Cannot be compared"
          ],
          "answer": 1,
          "hint": "Convert both fractions to a common denominator (12), then compare the numerators.",
          "steps": [
            {
              "explain": "Find the lowest common denominator of 4 and 6, which is 12.",
              "work": "\\(\\dfrac{3}{4}=\\dfrac{9}{12}, \\quad \\dfrac{5}{6}=\\dfrac{10}{12}\\)"
            },
            {
              "explain": "Compare the numerators now that the denominators match.",
              "work": "\\(\\dfrac{10}{12} \\gt \\dfrac{9}{12}\\)"
            },
            {
              "explain": "So the original fraction with the larger equivalent numerator is greater.",
              "work": "\\(\\dfrac{5}{6} \\gt \\dfrac{3}{4}\\)"
            }
          ]
        },
        {
          "id": "y6-rqf-1-q2",
          "type": "mc",
          "difficulty": "medium",
          "stem": "Which fraction is greater: \\(\\dfrac{2}{5}\\) or \\(\\dfrac{3}{7}\\)?",
          "options": [
            "\\(\\dfrac{2}{5}\\)",
            "\\(\\dfrac{3}{7}\\)",
            "They are equal",
            "Cannot be compared"
          ],
          "answer": 1,
          "hint": "Find the lowest common denominator of 5 and 7, which is 35.",
          "steps": [
            {
              "explain": "Convert both fractions to have a common denominator of 35.",
              "work": "\\(\\dfrac{2}{5}=\\dfrac{14}{35}, \\quad \\dfrac{3}{7}=\\dfrac{15}{35}\\)"
            },
            {
              "explain": "Compare the numerators.",
              "work": "\\(\\dfrac{15}{35} \\gt \\dfrac{14}{35}\\)"
            },
            {
              "explain": "So \\(\\dfrac{3}{7}\\) is the greater fraction.",
              "work": "\\(\\dfrac{3}{7} \\gt \\dfrac{2}{5}\\)"
            }
          ]
        },
        {
          "id": "y6-rqf-1-q3",
          "type": "mc",
          "difficulty": "easy",
          "stem": "Which of the following fractions is equivalent to \\(\\dfrac{2}{3}\\)?",
          "options": [
            "\\(\\dfrac{6}{9}\\)",
            "\\(\\dfrac{4}{9}\\)",
            "\\(\\dfrac{3}{2}\\)",
            "\\(\\dfrac{2}{6}\\)"
          ],
          "answer": 0,
          "hint": "Multiply the numerator and denominator by the same number.",
          "steps": [
            {
              "explain": "Multiply both the numerator and denominator of \\(\\dfrac{2}{3}\\) by 3.",
              "work": "\\(\\dfrac{2\\times3}{3\\times3}=\\dfrac{6}{9}\\)"
            }
          ]
        }
      ]
    },
    {
      "topicId": "y6-rqf-2",
      "code": "MA3-RQF-01",
      "title": "Add fractions with related denominators",
      "questions": [
        {
          "id": "y6-rqf-2-q1",
          "type": "mc",
          "difficulty": "easy",
          "stem": "Calculate: \\(\\dfrac{1}{2}+\\dfrac{1}{4}\\).",
          "options": [
            "\\(\\dfrac{3}{4}\\)",
            "\\(\\dfrac{2}{6}\\)",
            "\\(\\dfrac{1}{6}\\)",
            "\\(\\dfrac{2}{4}\\)"
          ],
          "answer": 0,
          "hint": "Since 4 is a multiple of 2, rewrite \\(\\dfrac12\\) with a denominator of 4.",
          "steps": [
            {
              "explain": "Convert \\(\\dfrac12\\) to an equivalent fraction with denominator 4.",
              "work": "\\(\\dfrac{1}{2}=\\dfrac{2}{4}\\)"
            },
            {
              "explain": "Add the numerators now that the denominators match.",
              "work": "\\(\\dfrac{2}{4}+\\dfrac{1}{4}=\\dfrac{3}{4}\\)"
            }
          ]
        },
        {
          "id": "y6-rqf-2-q2",
          "type": "mc",
          "difficulty": "medium",
          "stem": "Calculate: \\(\\dfrac{2}{3}+\\dfrac{1}{6}\\).",
          "options": [
            "\\(\\dfrac{5}{6}\\)",
            "\\(\\dfrac{3}{9}\\)",
            "\\(\\dfrac{3}{6}\\)",
            "\\(\\dfrac{1}{2}\\)"
          ],
          "answer": 0,
          "hint": "Since 6 is a multiple of 3, rewrite \\(\\dfrac23\\) with a denominator of 6.",
          "steps": [
            {
              "explain": "Convert \\(\\dfrac23\\) to an equivalent fraction with denominator 6.",
              "work": "\\(\\dfrac{2}{3}=\\dfrac{4}{6}\\)"
            },
            {
              "explain": "Add the numerators.",
              "work": "\\(\\dfrac{4}{6}+\\dfrac{1}{6}=\\dfrac{5}{6}\\)"
            }
          ]
        },
        {
          "id": "y6-rqf-2-q3",
          "type": "mc",
          "difficulty": "medium",
          "stem": "Calculate: \\(\\dfrac{3}{4}-\\dfrac{1}{8}\\).",
          "options": [
            "\\(\\dfrac{5}{8}\\)",
            "\\(\\dfrac{2}{4}\\)",
            "\\(\\dfrac{2}{8}\\)",
            "\\(\\dfrac{3}{8}\\)"
          ],
          "answer": 0,
          "hint": "Rewrite \\(\\dfrac34\\) with a denominator of 8.",
          "steps": [
            {
              "explain": "Convert \\(\\dfrac34\\) to an equivalent fraction with denominator 8.",
              "work": "\\(\\dfrac{3}{4}=\\dfrac{6}{8}\\)"
            },
            {
              "explain": "Subtract the numerators.",
              "work": "\\(\\dfrac{6}{8}-\\dfrac{1}{8}=\\dfrac{5}{8}\\)"
            }
          ]
        }
      ]
    },
    {
