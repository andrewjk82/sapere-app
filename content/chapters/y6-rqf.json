      "title": "Fractions of whole numbers",
      "questions": [
        {
          "id": "y6-rqf-3-q1",
          "type": "mc",
          "difficulty": "easy",
          "stem": "Find \\(\\dfrac{3}{5}\\) of \\(40\\).",
          "options": [
            "\\(24\\)",
            "\\(15\\)",
            "\\(8\\)",
            "\\(35\\)"
          ],
          "answer": 0,
          "hint": "Divide 40 by the denominator first, then multiply by the numerator.",
          "steps": [
            {
              "explain": "Divide 40 by the denominator, 5, to find one fifth.",
              "work": "\\(40\\div5=8\\)"
            },
            {
              "explain": "Multiply by the numerator, 3, to find three fifths.",
              "work": "\\(8\\times3=24\\)"
            }
          ]
        },
        {
          "id": "y6-rqf-3-q2",
          "type": "mc",
          "difficulty": "medium",
          "stem": "A netball team scored 60 points in a match. \\(\\dfrac{2}{3}\\) of the points were scored in the first half. How many points were scored in the first half?",
          "options": [
            "\\(40\\)",
            "\\(30\\)",
            "\\(20\\)",
            "\\(45\\)"
          ],
          "answer": 0,
          "hint": "Divide 60 by 3, then multiply by 2.",
          "steps": [
            {
              "explain": "Divide the total by the denominator, 3, to find one third.",
              "work": "\\(60\\div3=20\\)"
            },
            {
              "explain": "Multiply by the numerator, 2, to find two thirds.",
              "work": "\\(20\\times2=40\\)"
            }
          ]
        },
        {
          "id": "y6-rqf-3-q3",
          "type": "mc",
          "difficulty": "medium",
          "stem": "Find \\(\\dfrac{7}{10}\\) of \\(90\\).",
          "options": [
            "\\(63\\)",
            "\\(70\\)",
            "\\(9\\)",
            "\\(83\\)"
          ],
          "answer": 0,
          "hint": "Divide 90 by 10 first, then multiply by 7.",
          "steps": [
            {
              "explain": "Divide 90 by the denominator, 10.",
              "work": "\\(90\\div10=9\\)"
            },
            {
              "explain": "Multiply by the numerator, 7.",
              "work": "\\(9\\times7=63\\)"
            }
          ]
        }
      ]
