              "steps": [
                {
                  "explain": "Step 1: Identify the \\(y\\)-intercept.",
                  "work": "$$ \\text{When } x = 0, \\quad y = 2(0)^3 - 3(0)^2 - 12(0) + 5 = 5 \\implies (0, 5) $$"
                },
                {
