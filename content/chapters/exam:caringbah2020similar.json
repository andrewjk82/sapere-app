  "topics": [
    {
      "topicId": "y12a-5B",
      "code": "5B",
      "title": "Differentiation of e^x",
      "questions": [
        {
          "id": "car2020s-q14",
          "type": "multipart",
          "difficulty": "medium",
          "stem": "Differentiate each of the following functions.",
          "parts": [
            {
              "id": "car2020s-q14a",
              "type": "mc",
              "difficulty": "medium",
              "stem": "Differentiate \\(y = x^{3} e^{x}\\).",
              "options": [
                "\\(3x^{2} e^{x}\\)",
                "\\(x^{2} e^{x}(x+3)\\)",
                "\\(3x^{2} e^{x}+x^{3}\\)",
                "\\(x^{3} e^{x}+3x^{2}\\)"
              ],
              "answer": 1,
              "hint": "Product rule with \\(u=x^{3}\\), \\(v=e^{x}\\). Factor \\(x^{2} e^{x}\\).",
              "steps": [
                {
                  "explain": "Product form \\(y=x^{3}\\cdot e^{x}\\). Set \\(u=x^{3}\\), \\(v=e^{x}\\) for the product rule \\((uv)'=u'v+uv'\\).",
                  "work": "\\(u=x^{3},\\quad v=e^{x}\\)"
                },
                {
                  "explain": "Differentiate: \\(u'=3x^{2}\\) and \\(v'=e^{x}\\).",
                  "work": "\\(u'=3x^{2},\\quad v'=e^{x}\\)"
                },
                {
                  "explain": "Product rule: \\(y'=3x^{2} e^{x}+x^{3} e^{x}\\).",
                  "work": "\\(y'=3x^{2} e^{x}+x^{3} e^{x}\\)"
                },
                {
                  "explain": "Factor \\(x^{2} e^{x}\\): \\(y'=x^{2} e^{x}(3+x)=x^{2} e^{x}(x+3)\\).",
                  "work": "\\(y'=x^{2} e^{x}(x+3)\\)"
                }
              ]
            },
            {
              "id": "car2020s-q14b",
              "type": "mc",
              "difficulty": "medium",
              "stem": "Differentiate \\(f(x)=\\dfrac{e^{x}-1}{3x}\\).",
              "options": [
                "\\(\\dfrac{e^{x}}{3x}\\)",
                "\\(\\dfrac{x e^{x}-e^{x}+1}{3x^{2}}\\)",
                "\\(\\dfrac{3x e^{x}-(e^{x}-1)}{9x^{2}}\\)",
                "\\(\\dfrac{e^{x}-1}{3x^{2}}\\)"
              ],
              "answer": 1,
              "hint": "Quotient rule with \\(u=e^{x}-1\\), \\(v=3x\\). Watch the sign when expanding \\(-(e^{x}-1)\\).",
              "steps": [
                {
                  "explain": "Quotient \\(f=\\dfrac{e^{x}-1}{3x}\\). Set \\(u=e^{x}-1\\), \\(v=3x\\).",
                  "work": "\\(u=e^{x}-1,\\quad v=3x\\)"
                },
                {
                  "explain": "Differentiate: \\(u'=e^{x}\\), \\(v'=3\\).",
                  "work": "\\(u'=e^{x},\\quad v'=3\\)"
                },
                {
                  "explain": "Quotient rule: \\(f'=\\dfrac{3x\\cdot e^{x}-(e^{x}-1)\\cdot 3}{(3x)^{2}}=\\dfrac{3x e^{x}-3e^{x}+3}{9x^{2}}\\).",
                  "work": "\\(\\dfrac{3xe^{x}-3e^{x}+3}{9x^{2}}\\)"
                },
                {
                  "explain": "Cancel a common factor of 3: numerator \\(x e^{x}-e^{x}+1\\), denominator \\(3x^{2}\\). So \\(f'(x)=\\dfrac{x e^{x}-e^{x}+1}{3x^{2}}\\).",
                  "work": "\\(\\dfrac{xe^{x}-e^{x}+1}{3x^{2}}\\)"
                }
              ]
            }
          ],
          "answer": "See parts (a) and (b).",
          "hint": "Part (a): product rule. Part (b): quotient rule.",
          "solution": "See sub-question solutions.",
          "timeLimit": 90,
          "meta": {
            "source": "Caringbah 2020 Trial Q14"
          }
        }
      ]
    },
    {
      "topicId": "y12a-5C",
      "code": "5C",
      "title": "Applications of differentiation",
      "questions": [
        {
          "id": "car2020s-q37",
          "type": "multipart",
          "difficulty": "hard",
          "stem": "At time \\(t\\) years after purchase, the value \\(\\$V\\) of a laptop is given by\n\\( V = 1\\,200e^{-0.4t} \\).",
          "parts": [
            {
              "id": "car2020s-q37a",
              "type": "mc",
              "stem": "Find the loss in value of the laptop during the second year (from the start of year 2 to the end of year 2).",
              "options": [
                "\\(\\$120\\)",
                "\\(\\$200\\)",
                "\\(\\$265\\) (approx.)",
                "\\(\\$480\\) (approx.)"
              ],
              "answer": 2,
              "hint": "The second year runs from \\(t=1\\) to \\(t=2\\). Loss \\(= V(1)-V(2)\\).",
              "solution": "Loss \\(= V(1)-V(2)=1\\,200\\bigl(e^{-0.4}-e^{-0.8}\\bigr)\\approx 1\\,200(0.6703-0.4493)\\approx \\$265\\).",
              "steps": [
                {
                  "explain": "The second year of ownership runs from the end of year 1 to the end of year 2, i.e. from \\(t=1\\) to \\(t=2\\). The loss in value is \\(V(1)-V(2)\\).",
                  "work": "\\(\\text{Loss} = V(1) - V(2)\\)"
                },
                {
                  "explain": "Substitute into \\(V = 1\\,200e^{-0.4t}\\):\n\\(V(1) = 1\\,200e^{-0.4}\\),\n\\(V(2) = 1\\,200e^{-0.8}\\).",
                  "work": "\\(V(1)=1\\,200e^{-0.4},\\quad V(2)=1\\,200e^{-0.8}\\)"
                },
                {
                  "explain": "Factor out the constant 1 200:",
                  "work": "\\(\\text{Loss} = 1\\,200\\bigl(e^{-0.4}-e^{-0.8}\\bigr)\\)"
                },
                {
                  "explain": "Evaluate numerically (using \\(e^{-0.4}\\approx 0.6703\\) and \\(e^{-0.8}\\approx 0.4493\\)):",
                  "work": "\\(1\\,200(0.6703 - 0.4493) = 1\\,200\\times 0.2210 \\approx 265\\)"
                },
                {
                  "explain": "Therefore the loss during the second year is approximately \\(\\$265\\).",
                  "work": "\\(\\text{Loss} \\approx \\$265\\)"
                }
              ]
            },
            {
              "id": "car2020s-q37b",
              "type": "mc",
              "stem": "Find the year in which the laptop is losing value at a rate of \\(\\$50\\) per year.",
              "options": [
                "During the 4th year",
                "During the 6th year",
                "During the 8th year",
                "During the 10th year"
              ],
              "answer": 1,
              "hint": "Differentiate \\(V\\), set \\(\\left|\\dfrac{dV}{dt}\\right|=50\\), solve for \\(t\\), then interpret which year that falls in.",
              "solution": "\\(\\dfrac{dV}{dt}=-480e^{-0.4t}\\). Set \\(480e^{-0.4t}=50\\Rightarrow t=\\dfrac{\\ln(48/5)}{0.4}\\approx 5.65\\). So the rate is \\(\\$50\\) per year during the 6th year.",
              "steps": [
                {
                  "explain": "Differentiate \\(V=1\\,200e^{-0.4t}\\) using the chain rule (factor \\(-0.4\\) from the exponent):",
                  "work": "\\(\\dfrac{dV}{dt} = 1\\,200 \\cdot (-0.4)e^{-0.4t} = -480e^{-0.4t}\\)"
                },
                {
                  "explain": "The rate of loss is the magnitude \\(\\left|\\dfrac{dV}{dt}\\right|=480e^{-0.4t}\\). Set this equal to 50:",
                  "work": "\\(480e^{-0.4t} = 50\\)"
                },
                {
                  "explain": "Divide both sides by 480:",
                  "work": "\\(e^{-0.4t} = \\dfrac{50}{480} = \\dfrac{5}{48}\\)"
                },
                {
                  "explain": "Take natural log of both sides:",
                  "work": "\\(-0.4t = \\ln\\!\\left(\\dfrac{5}{48}\\right) = -\\ln\\!\\left(\\dfrac{48}{5}\\right)\\)"
                },
                {
                  "explain": "Solve for \\(t\\):",
                  "work": "\\(t = \\dfrac{\\ln(48/5)}{0.4} = \\dfrac{\\ln 9.6}{0.4} \\approx \\dfrac{2.262}{0.4} \\approx 5.65\\text{ years}\\)"
                },
                {
                  "explain": "Since \\(5 < 5.65 < 6\\), this occurs between the end of year 5 and the end of year 6 — that is, during the 6th year of ownership.",
                  "work": "\\(\\text{During the 6th year}\\)"
                }
              ]
            }
          ],
          "answer": "See parts (a) and (b).",
          "hint": "For (a), loss during the second year is \\(V(1)-V(2)\\). For (b), set \\(\\left|\\dfrac{dV}{dt}\\right|=50\\) and solve for \\(t\\).",
          "solution": "See sub-question solutions.",
          "timeLimit": 180,
          "meta": {
            "source": "Caringbah 2020 Trial Q37"
          }
        }
      ]
