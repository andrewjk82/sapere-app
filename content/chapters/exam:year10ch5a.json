          "stem": "Solve the equation:\n\n$$-8 = -x^2 + 6x$$",
          "answer": "x = 2, x = 4",
          "hint": "Rearrange the equation so that one side is zero, then factorise.",
          "steps": [
            {
              "explain": "Rearrange the equation to the standard form \\(ax^2 + bx + c = 0\\).",
              "work": "x^2 - 6x + 8 = 0"
            },
            {
              "explain": "Factorise.",
              "work": "(x - 2)(x - 4) = 0"
            },
            {
              "explain": "Solve.",
              "work": "x = 2, x = 4"
            }
          ],
          "timeLimit": 90
        },
