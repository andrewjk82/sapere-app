      "title": "Sums and products of zeroes",
      "questions": [
        {
          "id": "ascham2020e1-q11b",
          "type": "mc",
          "difficulty": "medium",
          "timeLimit": 60,
          "stem": "The polynomial \\(P(x)=x^3-4x^2+tx+10\\) has roots \\(\\alpha,-\\alpha\\) and \\(\\beta\\). Find the three roots and hence find the value of \\(t\\).",
          "hint": "Use sum of roots for β, product of roots for α², then sum of pairs for t.",
          "steps": [
            {
              "explain": "Sum of roots \\(=-\\frac ba=4\\). The pair \\(\\alpha,-\\alpha\\) cancels.",
              "work": "\\(\\alpha+(-\\alpha)+\\beta=4\\ \\Rightarrow\\ \\beta=4\\)"
            },
            {
              "explain": "Product of roots \\(=-\\frac da=-10\\).",
              "work": "\\(\\alpha(-\\alpha)(4)=-10\\ \\Rightarrow\\ -4\\alpha^2=-10\\ \\Rightarrow\\ \\alpha^2=\\frac52,\\ \\alpha=\\sqrt{\\tfrac52}\\)"
            },
            {
              "explain": "Sum of products in pairs \\(=\\frac ca=t\\).",
              "work": "\\(t=\\alpha(-\\alpha)+\\alpha\\beta+(-\\alpha)\\beta=-\\alpha^2=-\\frac52\\)"
            },
            {
              "explain": "Check: \\(P(4)=64-64+4t+10=0\\Rightarrow t=-\\frac52\\) ✓."
            }
          ],
          "xp": 1,
          "meta": {
            "source": "Ascham 2020 3U Trial",
            "examPaper": "Ascham 2020 3U Trial & Solutions",
            "school": "Ascham",
            "year": 2020,
            "number": "11(b)"
          },
          "options": [
            "Roots \\(\\sqrt{\\tfrac52},\\ -\\sqrt{\\tfrac52},\\ -4\\); \\(t=-\\frac52\\)",
            "Roots \\(\\sqrt{\\tfrac52},\\ -\\sqrt{\\tfrac52},\\ 4\\); \\(t=-\\frac52\\)",
            "Roots \\(\\sqrt{\\tfrac52},\\ -\\sqrt{\\tfrac52},\\ 4\\); \\(t=\\frac52\\)",
            "Roots \\(\\sqrt{10},\\ -\\sqrt{10},\\ 4\\); \\(t=-10\\)"
          ],
          "answer": 1,
          "keyPoints": [
            {
              "text": "has roots \\(\\alpha,-\\alpha\\) and \\(\\beta\\)",
              "note": "α and −α cancel in the sum, so β = 4 straight away."
            }
          ]
        },
        {
          "id": "bhhs2020e1-q14b",
          "type": "mc",
          "difficulty": "hard",
          "timeLimit": 60,
          "stem": "If \\(\\alpha\\) and \\(\\beta\\) are the roots of the equation \\(x^2+mx+n=0\\), find the roots of \\(nx^2-mx+1=0\\) in terms of \\(\\alpha\\) and \\(\\beta\\).",
          "hint": "Use α + β = −m, αβ = n, then compare sum and product of the new roots.",
          "steps": [
            {
              "explain": "Sum and product of roots of \\(x^2+mx+n=0\\).",
              "work": "\\(\\alpha+\\beta=-m,\\qquad\\alpha\\beta=n\\)"
            },
            {
              "explain": "Divide \\(nx^2-mx+1=0\\) by \\(n\\) and substitute.",
              "work": "\\(x^2-\\frac{m}{n}x+\\frac1n=0\\ \\Rightarrow\\ x^2+\\frac{\\alpha+\\beta}{\\alpha\\beta}x+\\frac{1}{\\alpha\\beta}=0\\)"
            },
            {
              "explain": "Guess \\(-\\frac1\\alpha\\) and \\(-\\frac1\\beta\\): check their sum and product.",
              "work": "\\(-\\frac1\\alpha-\\frac1\\beta=-\\frac{\\alpha+\\beta}{\\alpha\\beta},\\qquad\\left(-\\frac1\\alpha\\right)\\left(-\\frac1\\beta\\right)=\\frac{1}{\\alpha\\beta}\\)"
            },
            {
              "explain": "The sum must be \\(-\\frac{\\alpha+\\beta}{\\alpha\\beta}\\) (= minus the \\(x\\)-coefficient) and the product \\(\\frac{1}{\\alpha\\beta}\\) — both match. So the roots are \\(-\\frac1\\alpha\\) and \\(-\\frac1\\beta\\)."
            }
          ],
          "xp": 1,
          "meta": {
            "source": "Baulkham Hills 2020 3U Trials & Solutions",
            "school": "Baulkham Hills High School",
            "year": 2020,
            "number": "14(b)"
          },
          "options": [
            "\\(-\\alpha\\) and \\(-\\beta\\)",
            "\\(\\alpha\\beta\\) and \\(\\alpha+\\beta\\)",
            "\\(-\\frac{1}{\\alpha}\\) and \\(-\\frac{1}{\\beta}\\)",
            "\\(\\frac{1}{\\alpha}\\) and \\(\\frac{1}{\\beta}\\)"
          ],
          "answer": 2,
          "keyPoints": [
            {
              "text": "find the roots of \\(nx^2-mx+1=0\\)",
              "note": "Write m and n using α and β; the new equation's sum is m/n and product 1/n."
            }
          ]
        },
        {
