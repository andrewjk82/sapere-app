      "title": "Sums and products of zeroes",
      "questions": [
        {
          "id": "ascham2020e1-q11b",
          "type": "mc",
          "difficulty": "medium",
          "timeLimit": 60,
          "stem": "The polynomial \\(P(x)=x^3-4x^2+tx+10\\) has roots \\(\\alpha,-\\alpha\\) and \\(\\beta\\). Find the three roots and hence find the value of \\(t\\).",
          "hint": "Use sum of roots for β, product of roots for α², then sum of pairs for t.",
          "steps": [
            {
              "explain": "Sum of roots \\(=-\\frac ba=4\\). The pair \\(\\alpha,-\\alpha\\) cancels.",
              "work": "\\(\\alpha+(-\\alpha)+\\beta=4\\ \\Rightarrow\\ \\beta=4\\)"
            },
            {
              "explain": "Product of roots \\(=-\\frac da=-10\\).",
              "work": "\\(\\alpha(-\\alpha)(4)=-10\\ \\Rightarrow\\ -4\\alpha^2=-10\\ \\Rightarrow\\ \\alpha^2=\\frac52,\\ \\alpha=\\sqrt{\\tfrac52}\\)"
            },
            {
              "explain": "Sum of products in pairs \\(=\\frac ca=t\\).",
              "work": "\\(t=\\alpha(-\\alpha)+\\alpha\\beta+(-\\alpha)\\beta=-\\alpha^2=-\\frac52\\)"
            },
            {
              "explain": "Check: \\(P(4)=64-64+4t+10=0\\Rightarrow t=-\\frac52\\) ✓."
            }
          ],
          "xp": 1,
          "meta": {
            "source": "Ascham 2020 3U Trial",
            "examPaper": "Ascham 2020 3U Trial & Solutions",
            "school": "Ascham",
            "year": 2020,
            "number": "11(b)"
          },
          "options": [
            "Roots \\(\\sqrt{\\tfrac52},\\ -\\sqrt{\\tfrac52},\\ -4\\); \\(t=-\\frac52\\)",
            "Roots \\(\\sqrt{\\tfrac52},\\ -\\sqrt{\\tfrac52},\\ 4\\); \\(t=-\\frac52\\)",
            "Roots \\(\\sqrt{\\tfrac52},\\ -\\sqrt{\\tfrac52},\\ 4\\); \\(t=\\frac52\\)",
            "Roots \\(\\sqrt{10},\\ -\\sqrt{10},\\ 4\\); \\(t=-10\\)"
          ],
          "answer": 1,
          "keyPoints": [
