          "parts": [
            {
              "id": "y9-11b-q3a",
              "type": "short",
              "stem": "Find the missing midpoint \\(M\\) for row a.",
              "answer": "(4, 8)",
              "steps": [
                {
                  "explain": "Find the average of \\(x\\) and \\(y\\) coordinates.",
                  "work": "M = \\left(\\frac{2+6}{2}, \\frac{5+11}{2}\\right) = (4, 8)"
                }
              ],
              "xp": 2
            },
            {
              "id": "y9-11b-q3b",
              "type": "short",
              "stem": "Find the missing point \\(A\\) for row b.",
              "answer": "(12, 15)",
              "steps": [
                {
                  "explain": "Use the formula \\(A = 2M - B\\).",
                  "work": "A = 2(8, 10) - (4, 5) = (16, 20) - (4, 5) = (12, 15)"
                }
              ],
              "xp": 2
            },
            {
              "id": "y9-11b-q3c",
              "type": "short",
              "stem": "Find the missing point \\(B\\) for row c.",
              "answer": "(6, 1)",
              "steps": [
                {
                  "explain": "Use the formula \\(B = 2M - A\\).",
                  "work": "B = 2(2, -2) - (-2, -5) = (4, -4) - (-2, -5) = (6, 1)"
                }
              ],
              "xp": 2
            },
            {
              "id": "y9-11b-q3d",
              "type": "short",
              "stem": "Find the missing midpoint \\(M\\) for row d.",
              "answer": "(4.6, 3.75)",
              "steps": [
                {
                  "explain": "Average the coordinates of \\(A(1.5, 5.3)\\) and \\(B(7.7, 2.2)\\).",
                  "work": "M = \\left(\\frac{1.5+7.7}{2}, \\frac{5.3+2.2}{2}\\right) = (4.6, 3.75)"
                }
              ],
              "xp": 2
            },
            {
              "id": "y9-11b-q3e",
              "type": "short",
              "stem": "Find the missing point \\(A\\) for row e.",
              "answer": "(3.5, 0.1)",
              "steps": [
                {
                  "explain": "Use the formula \\(A = 2M - B\\).",
                  "work": "A = 2(0.5, -1.5) - (-2.5, -3.1) = (1, -3) - (-2.5, -3.1) = (3.5, 0.1)"
                }
              ],
              "xp": 2
            },
            {
              "id": "y9-11b-q3f",
              "type": "short",
              "stem": "Find the missing point \\(B\\) for row f.",
              "answer": "(4.8, 3)",
              "steps": [
                {
                  "explain": "Use the formula \\(B = 2M - A\\).",
                  "work": "B = 2(0, 4) - (-4.8, 5) = (0, 8) - (-4.8, 5) = (4.8, 3)"
                }
              ],
              "xp": 2
            }
          ],
          "answer": "a) (4, 8), b) (12, 15), c) (6, 1), d) (4.6, 3.75), e) (3.5, 0.1), f) (4.8, 3)",
          "timeLimit": 90
        },
