              "type": "short",
              "stem": "Find the coordinates of \\(M\\).",
              "answer": "(3, 3)",
              "steps": [
                {
                  "explain": "Find the midpoint of \\(AB\\) where \\(A(1,2)\\) and \\(B(5,4)\\).",
                  "work": "M = \\left(\\frac{1+5}{2}, \\frac{2+4}{2}\\right) = (3, 3)"
                }
              ],
              "xp": 2
            },
            {
              "id": "y9-11b-q4b",
              "type": "short",
              "stem": "Find the coordinates of \\(N\\).",
              "answer": "(4, 1)",
              "steps": [
                {
                  "explain": "Find the midpoint of \\(AC\\) where \\(A(1,2)\\) and \\(C(7,0)\\).",
                  "work": "N = \\left(\\frac{1+7}{2}, \\frac{2+0}{2}\\right) = (4, 1)"
                }
              ],
              "xp": 2
            },
            {
              "id": "y9-11b-q4c",
              "type": "short",
              "stem": "Calculate the distance \\(BC\\).",
              "answer": "2\\sqrt{5}",
              "steps": [
                {
                  "explain": "Use distance formula for \\(B(5,4)\\) and \\(C(7,0)\\).",
                  "work": "BC = \\sqrt{(7-5)^2 + (0-4)^2} = \\sqrt{20} = 2\\sqrt{5}"
                }
              ],
              "xp": 2
            },
            {
              "id": "y9-11b-q4d",
              "type": "short",
              "stem": "Calculate the distance \\(MN\\).",
              "answer": "\\sqrt{5}",
              "steps": [
                {
                  "explain": "Use distance formula for \\(M(3,3)\\) and \\(N(4,1)\\).",
                  "work": "MN = \\sqrt{(4-3)^2 + (1-3)^2} = \\sqrt{5}"
                }
              ],
              "xp": 2
            },
            {
              "id": "y9-11b-q4e",
              "type": "short",
              "stem": "Compare the distance \\(BC\\) with the distance \\(MN\\).",
              "answer": "BC = 2MN",
              "steps": [
                {
                  "explain": "Observe the relationship between \\(2\\sqrt{5}\\) and \\(\\sqrt{5}\\).",
                  "work": "BC = 2 \\times MN"
                }
              ],
              "xp": 2
            },
            {
              "id": "y9-11b-q4f",
              "type": "short",
              "stem": "What is the relation between \\(\\Delta ABC\\) and \\(\\Delta AMN\\)?",
              "answer": "Similar triangles",
              "steps": [
                {
                  "explain": "Identify the similarity by matching angles and side ratios.",
                  "work": "\\Delta ABC \\sim \\Delta AMN \\quad \\text{(SAS similarity, scale factor 2)}"
                }
              ],
              "xp": 2
            }
          ],
          "answer": "M(3, 3), N(4, 1), BC = 2\\sqrt{5}, MN = \\sqrt{5}, BC = 2MN, similar triangles",
          "timeLimit": 90
