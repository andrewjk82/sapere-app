        },
        {
          "id": "abbotsleigh2021-ext2-q7",
          "type": "mc",
          "difficulty": "medium",
          "timeLimit": 60,
          "stem": "The number \\(1+2i\\) is a root of \\(z^3-z^2+qz+5=0\\), where q is real. Find q.",
          "hint": "Because the coefficients are real, \\(1-2i\\) is also a root. Use the product of all three roots, then the sum of pairwise products.",
          "steps": [
            {
              "explain": "Because the polynomial has real coefficients, the conjugate of the non-real root is also a root.",
              "work": "\\(1+2i\\text{ root}\\quad\\Longrightarrow\\quad1-2i\\text{ root}.\\)"
            },
            {
              "explain": "Use the product of the three roots. For a monic cubic with constant term 5, the product is −5.",
              "work": "\\((1+2i)(1-2i)\\alpha=-5.\\)"
            },
            {
              "explain": "Multiply the conjugate pair and solve for the third root α.",
              "work": "\\((1+2i)(1-2i)=1-(2i)^2=1+4=5,\\quad5\\alpha=-5,\\quad\\alpha=-1.\\)"
            },
            {
              "explain": "For a monic cubic, q is the sum of the pairwise products of its roots. Substitute all three roots.",
              "work": "\\(q=(1+2i)(1-2i)+(1+2i)(-1)+(1-2i)(-1)=5-1-2i-1+2i=3.\\) Hence \\(\\boxed{q=3}\\)."
            }
          ],
          "xp": 1,
          "meta": {
            "source": "Abbotsleigh 2021 4U Trials & Solutions",
            "school": "Abbotsleigh",
            "year": 2021
          },
          "options": [
            "\\(-3\\)",
            "\\(-1\\)",
            "\\(3\\)",
            "\\(1\\)"
          ],
          "answer": 2,
          "solution": "\\(q=3\\)",
          "keyPoints": [
            {
              "text": "\\(1+2i\\) is a root",
              "note": "A real-coefficient polynomial also has the conjugate root 1−2i."
            }
          ]
        }
      ]
