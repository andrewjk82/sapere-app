    {
      "topicId": "y9-12d",
      "code": "12D",
      "title": "Multi-stage experiments",
      "questions": [
        {
          "id": "y9-willoughby-19-t7q2",
          "type": "mc",
          "difficulty": "medium",
          "stem": "Two coins are tossed. Find the probability that the result on both coins is a tail.",
          "options": [
            "$\\frac{1}{3}$",
            "$\\frac{1}{4}$",
            "$\\frac{1}{2}$",
            "$1$"
          ],
          "answer": 1,
          "steps": [
            {
              "explain": "A fair coin has probability $\\frac{1}{2}$ of landing on tails. The two coin tosses are independent events (one doesn't affect the other), so the probability of both events happening is the product of their individual probabilities.",
              "work": "\\(P(\\text{Tail and Tail}) = P(\\text{Tail}) \\times P(\\text{Tail})\\)"
            },
            {
              "explain": "Substitute $\\frac{1}{2}$ for each probability and multiply.",
              "work": "\\(\\frac{1}{2} \\times \\frac{1}{2} = \\frac{1 \\times 1}{2 \\times 2} = \\frac{1}{4}\\)"
            }
          ],
          "meta": {
            "source": "Willoughby Y9 2019 Yearly Exam",
            "school": "Willoughby Girls High School",
            "examType": "Yearly",
            "grade": "9",
            "topic": "y9-12d"
          },
          "xp": 2
        }
      ]
    }
