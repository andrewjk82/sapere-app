      "title": "Grouping",
      "questions": [
        {
          "id": "ch9t3-q19",
          "type": "mc",
          "difficulty": "hard",
          "stem": "Which of the following is the complete factorisation of \\(24x^3-4x^2-6x+1\\)?",
          "options": [
            "\\((2x-1)^2(6x-1)\\)",
            "\\((2x-1)(2x+1)(6x-1)\\)",
            "\\((2x-1)(2x+1)(6x+1)\\)",
            "\\((4x-1)(6x^2-1)\\)"
          ],
          "answer": 1,
          "hint": "Group the four terms into two pairs, factor each pair to reveal a common bracket, then factorise the resulting difference of squares.",
          "steps": [
            {
              "explain": "Group the terms into two pairs: the first two terms share a factor of \\(4x^2\\), and the last two share a factor of \\(-1\\).",
              "work": "\\(24x^3-4x^2-6x+1 = 4x^2(6x-1) - 1(6x-1)\\)"
            },
            {
              "explain": "Both terms now share the common factor \\((6x-1)\\) — factor it out.",
              "work": "\\(= (4x^2-1)(6x-1)\\)"
            },
            {
              "explain": "Recognise \\(4x^2-1\\) as a difference of squares, \\((2x)^2-1^2\\), and factorise it further.",
              "work": "\\(4x^2-1 = (2x-1)(2x+1)\\)"
            },
            {
              "explain": "Combine for the complete factorisation.",
              "work": "\\(= (2x-1)(2x+1)(6x-1)\\)"
            }
          ],
          "meta": {
            "source": "Chatswood HS Year 9 Assessment Task 3 (2025)",
            "school": "Chatswood High School",
            "examType": "Assessment Task",
            "grade": "9"
          }
        },
