            },
            {
              "explain": "Collect like terms.",
              "work": "\\(\\frac{x + 13}{15}\\)"
            }
          ]
        },
        {
          "id": "y9-ep1-alg-quad-3b",
          "type": "mc",
          "stem": "Simplify:<br><br>\\(\\frac{x^2 + 3x - 4}{x^2 - 9} \\times \\frac{4x - 12}{x + 4}\\)",
          "options": [
            "\\(\\frac{4(x - 1)}{x + 3}\\)",
            "\\(\\frac{4(x + 1)}{x - 3}\\)",
            "\\(\\frac{4(x - 4)}{x + 3}\\)",
            "\\(\\frac{x - 1}{x + 3}\\)"
          ],
          "answer": 0,
          "hint": "Factorise every numerator and denominator first, then cancel out common factors.",
          "steps": [
            {
              "explain": "Factorise \\(x^2 + 3x - 4\\).",
              "work": "\\((x + 4)(x - 1)\\)"
            },
            {
              "explain": "Factorise \\(x^2 - 9\\) (difference of two squares).",
              "work": "\\((x + 3)(x - 3)\\)"
            },
            {
              "explain": "Factorise \\(4x - 12\\).",
              "work": "\\(4(x - 3)\\)"
            },
            {
              "explain": "Substitute the factorised forms back into the expression.",
              "work": "\\(\\frac{(x + 4)(x - 1)}{(x + 3)(x - 3)} \\times \\frac{4(x - 3)}{x + 4}\\)"
            },
            {
              "explain": "Cancel out common factors in the numerator and denominator: \\((x + 4)\\) and \\((x - 3)\\).",
              "work": "\\(\\frac{x - 1}{x + 3} \\times \\frac{4}{1}\\)"
            },
            {
              "explain": "Multiply the remaining terms.",
              "work": "\\(\\frac{4(x - 1)}{x + 3}\\)"
            }
          ]
        },
