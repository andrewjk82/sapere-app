    {
      "topicId": "y6-gm-4",
      "code": "MA3-GM-03",
      "title": "Angles on a straight line",
      "questions": [
        {
          "id": "y6-gm-4-q1",
          "type": "mc",
          "difficulty": "medium",
          "stem": "In the diagram, \\(ABC\\) is a straight line. Find the value of \\(x\\).",
          "figure": {
            "svg": "fig:e6c8e3588f"
          },
          "options": [
            "\\(65°\\)",
            "\\(115°\\)",
            "\\(25°\\)",
            "\\(295°\\)"
          ],
          "answer": 1,
          "hint": "Angles on a straight line add to \\(180°\\).",
          "steps": [
            {
              "explain": "Since \\(ABC\\) is a straight line, \\(\\angle ABD\\) and \\(\\angle DBC\\) add to \\(180°\\).",
              "work": "\\(65°+x=180°\\)"
            },
            {
              "explain": "Solve for \\(x\\).",
              "work": "\\(x=180°-65°=115°\\)"
            }
          ],
          "xp": 2
        },
        {
          "id": "y6-gm-4-q2",
          "type": "mc",
          "difficulty": "easy",
          "stem": "Two angles on a straight line are \\(38°\\) and \\(y°\\). Find \\(y\\).",
          "options": [
            "\\(38\\)",
            "\\(52\\)",
            "\\(142\\)",
            "\\(322\\)"
          ],
          "answer": 2,
          "hint": "Angles on a straight line add to \\(180°\\).",
          "steps": [
            {
              "explain": "Set up the angle sum equation.",
              "work": "\\(38+y=180\\)"
            },
            {
              "explain": "Solve for \\(y\\).",
              "work": "\\(y=180-38=142\\)"
            }
          ],
          "xp": 1
        }
      ]
    },
    {
