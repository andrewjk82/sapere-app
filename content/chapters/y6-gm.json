      "questions": [
        {
          "id": "y6-gm-5-q1",
          "type": "mc",
          "difficulty": "medium",
          "stem": "In the diagram, three angles meet at point \\(O\\). Find the value of \\(x\\).",
          "figure": {
            "svg": "fig:af58a12a83"
          },
          "options": [
            "\\(150°\\)",
            "\\(210°\\)",
            "\\(140°\\)",
            "\\(90°\\)"
          ],
          "answer": 0,
          "hint": "Angles at a point add to \\(360°\\).",
          "steps": [
            {
              "explain": "The three angles around point \\(O\\) add to \\(360°\\).",
              "work": "\\(90°+120°+x=360°\\)"
            },
            {
              "explain": "Simplify and solve for \\(x\\).",
              "work": "\\(210°+x=360° \\Rightarrow x=150°\\)"
            }
          ],
          "xp": 2
        },
        {
          "id": "y6-gm-5-q2",
          "type": "mc",
          "difficulty": "easy",
          "stem": "Four angles meet at a point: \\(70°\\), \\(95°\\), \\(110°\\) and \\(y°\\). Find \\(y\\).",
          "options": [
            "\\(95\\)",
            "\\(360\\)",
            "\\(275\\)",
            "\\(85\\)"
          ],
          "answer": 3,
          "hint": "Angles at a point add to \\(360°\\).",
          "steps": [
            {
              "explain": "Add the three known angles.",
              "work": "\\(70+95+110=275\\)"
            },
            {
              "explain": "Subtract from \\(360°\\) to find \\(y\\).",
              "work": "\\(y=360-275=85\\)"
            }
          ],
          "xp": 1
        }
      ]
