      "questions": [
        {
          "id": "abbotsleigh2025-ext2-q7",
          "type": "mc",
          "difficulty": "medium",
          "timeLimit": 60,
          "stem": "A unit-mass particle is projected vertically upwards at speed \\(u\\), with gravity \\(g\\) and resistance \\(\\frac12kv^2\\). Which integral gives its maximum height?",
          "hint": "Use upward displacement as positive. During ascent, gravity and drag both act downward; also use \\(v\\,dv/dx=a\\).",
          "solution": "\\(\\int_0^u\\frac{v}{g+kv^2/2}\\,dv\\)",
          "steps": [
            {
              "explain": "Write the acceleration while rising.",
              "work": "\\(a=\\frac{dv}{dt}=-g-\\frac12kv^2.\\)"
            },
            {
              "explain": "Change independent variable from time to displacement.",
              "work": "\\(a=v\\frac{dv}{dx}\\), so \\(dx=-\\frac{v}{g+kv^2/2}\\,dv.\\)"
            },
            {
              "explain": "Integrate from launch to the highest point.",
              "work": "\\(H=\\int_{u}^{0}-\\frac{v}{g+kv^2/2}dv=\\int_0^u\\frac{v}{g+kv^2/2}dv.\\)"
            }
          ],
          "xp": 1,
          "meta": {
            "source": "Abbotsleigh 2025 4U Trials & Solutions",
            "school": "Abbotsleigh"
          },
          "options": [
            "\\(\\int_u^0\\frac{v}{g+kv^2/2}\\,dv\\)",
            "\\(\\int_0^u\\frac{v}{g+kv^2/2}\\,dv\\)",
            "\\(\\int_0^u\\frac{v}{g-kv^2/2}\\,dv\\)",
            "\\(\\int_u^0\\frac{v}{g-kv^2/2}\\,dv\\)"
          ],
          "answer": 1,
          "keyPoints": [
            {
              "text": "A unit-mass particle is projected vertically upwards at speed \\(u\\), with gravity \\(g\\) and resistance \\(\\frac12kv^2\\)",
              "note": "Use upward displacement as positive. During ascent, gravity and drag both act downward; also use \\(v\\,dv/dx=a\\)."
            }
          ]
        },
