        {
          "id": "abbotsleigh2025-ext2-q15a_iii",
          "type": "mc",
          "difficulty": "medium",
          "timeLimit": 60,
          "stem": "For the falling body, which expression gives speed after falling distance x?",
          "hint": "Use \\(v\\,dv/dx=g-v^2/100\\), then solve the resulting linear differential equation in \\(v^2\\).",
          "solution": "\\(v^2=V^2(1-e^{-x/50})\\)",
          "steps": [
            {
              "explain": "Set w=v².",
              "work": "\\(\\frac12\\frac{dw}{dx}=g-\\frac{w}{100}.\\)"
            },
            {
              "explain": "Separate and integrate with v=0 at x=0.",
              "work": "\\(w=100g(1-e^{-x/50}).\\)"
            },
            {
              "explain": "Use terminal speed.",
              "work": "\\(V^2=100g\\), hence \\(v^2=V^2(1-e^{-x/50}).\\)"
            }
