        {
          "id": "abbotsleigh2025-ext2-q9",
          "type": "mc",
          "difficulty": "medium",
          "timeLimit": 60,
          "stem": "A driver claims the average speed over two parts is the arithmetic mean of the two average speeds. Which case is NOT a counterexample?",
          "hint": "For each case, compare total distance divided by total time with the mean of the two speeds.",
          "solution": "Option B",
          "steps": [
            {
              "explain": "Compute the proposed mean for option B.",
              "work": "\\((60+40)/2=50\\text{ km/h}.\\)"
            },
            {
              "explain": "Compute the actual average.",
              "work": "Total distance \\(=200\\) km; total time \\(=120/60+80/40=4\\) h, so average \\(=200/4=50\\) km/h."
            },
            {
              "explain": "Conclude this case agrees with the claim.",
              "work": "Option B is not a counterexample."
            }
          ],
          "xp": 1,
          "meta": {
            "source": "Abbotsleigh 2025 4U Trials & Solutions",
            "school": "Abbotsleigh"
          },
          "options": [
            "100 km at 20 km/h, then 100 km at 40 km/h",
            "120 km at 60 km/h, then 80 km at 40 km/h",
            "1 hour at 100 km/h, then 2 hours at 50 km/h",
            "60 km in 2 hours, then 40 km in 3 hours"
          ],
          "answer": 1,
          "keyPoints": [
            {
              "text": "A driver claims the average speed over two parts is the arithmetic mean of the two average speeds",
              "note": "For each case, compare total distance divided by total time with the mean of the two speeds."
            }
          ]
        },
        {
          "id": "abbotsleigh2025-ext2-q14d",
          "type": "mc",
          "difficulty": "medium",
          "timeLimit": 60,
          "stem": "Two birds have relative position \\(r=(-3,a+2,2)\\) and relative velocity \\(v=(1,9,-2)\\). If their minimum separation occurs at t=5, find a.",
          "hint": "At minimum separation, the relative position is perpendicular to the relative velocity: \\((r+5v)\\cdot v=0\\).",
          "solution": "\\(-49\\)",
          "steps": [
            {
              "explain": "Write the minimum-distance condition.",
              "work": "\\((r+5v)\\cdot v=0\\), equivalently \\(r\\cdot v+5|v|^2=0.\\)"
            },
            {
              "explain": "Calculate the dot products.",
              "work": "\\(r\\cdot v=-3+9(a+2)-4=9a+11\\); \\(|v|^2=1+81+4=86.\\)"
            },
            {
              "explain": "Solve for a.",
              "work": "\\(9a+11+430=0\\Rightarrow a=-49.\\)"
            }
          ],
          "xp": 1,
          "meta": {
            "source": "Abbotsleigh 2025 4U Trials & Solutions",
            "school": "Abbotsleigh"
          },
          "options": [
            "\\(-49\\)",
            "\\(49\\)",
            "\\(-11\\)",
            "\\(-\\frac{11}{9}\\)"
          ],
          "answer": 0,
          "keyPoints": [
            {
              "text": "Two birds have relative position \\(r=(-3,a+2,2)\\) and relative velocity \\(v=(1,9,-2)\\)",
              "note": "At minimum separation, the relative position is perpendicular to the relative velocity: \\((r+5v)\\cdot v=0\\)."
            }
          ]
        }
