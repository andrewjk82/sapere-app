          "type": "mc",
          "difficulty": "medium",
          "timeLimit": 60,
          "stem": "At what distance has the falling body first reached half its terminal speed?",
          "hint": "Substitute \\(v=V/2\\) into the speed-distance relation and solve the exponential equation.",
          "solution": "\\(50\\ln(4/3)\\text{ m}\\)",
          "steps": [
            {
              "explain": "Substitute the half-terminal speed.",
              "work": "\\(V^2/4=V^2(1-e^{-x/50}).\\)"
            },
            {
              "explain": "Isolate the exponential.",
              "work": "\\(e^{-x/50}=3/4.\\)"
            },
            {
              "explain": "Take logarithms.",
              "work": "\\(-x/50=\\ln(3/4)\\Rightarrow x=50\\ln(4/3)\\text{ m}.\\)"
