        {
          "id": "cgs2020e1-q11e",
          "type": "multipart",
          "difficulty": "hard",
          "stem": "A particle is moving such that, at time \\(t\\) seconds, its displacement, \\(x\\) metres, satisfies the equation \\(t=2-\\frac{1}{e^{3x}}\\). Show that the velocity of the particle can be represented by \\(\\frac{dx}{dt}=\\frac{e^{3x}}{3}\\,\\text{m s}^{-1}\\).",
          "hint": "Differentiate the given relation with respect to x to find velocity; then use the one-second condition to evaluate acceleration.",
          "keyPoints": [
            {
              "text": "\\(t=2-\\frac{1}{e^{3x}}\\)",
              "note": "This relation connects the given time to displacement."
            }
          ],
          "timeLimit": 60,
          "xp": 1,
          "meta": {
            "source": "Cheltenham Girls 2020 3U Trials & Solutions",
            "school": "Cheltenham Girls' High School",
            "year": 2020,
            "number": "11(e)",
            "sourceFile": "/Users/andrewkim/Desktop/Paperdone/ Done/Trail E1/Cheltenham Girls 2020 3U Trials & Solutions.pdf",
            "sourcePages": "9"
          },
          "parts": [
            {
              "id": "cgs2020e1-q11e-i",
              "type": "review",
              "difficulty": "hard",
              "stem": "A particle is moving such that, at time \\(t\\) seconds, its displacement, \\(x\\) metres, satisfies the equation \\(t=2-\\frac{1}{e^{3x}}\\). Show that the velocity of the particle can be represented by \\(\\frac{dx}{dt}=\\frac{e^{3x}}{3}\\,\\text{m s}^{-1}\\).",
              "answer": "\\(\\frac{dt}{dx}=3e^{-3x};\\quad\\frac{dx}{dt}=\\frac{1}{3e^{-3x}}=\\frac{e^{3x}}{3}\\,\\text{m s}^{-1}\\)",
              "hint": "Differentiate t with respect to x first, then take the reciprocal to obtain dx/dt.",
              "keyPoints": [
                {
                  "text": "Show that",
                  "note": "Focus on this information from the question when choosing the method and carrying out the calculation."
                }
              ],
              "steps": [
                {
                  "explain": "Rewrite 1/e^(3x) as e^(−3x) and differentiate t with respect to x.",
                  "work": "\\(t=2-e^{-3x};\\quad\\frac{dt}{dx}=3e^{-3x}\\)"
                },
                {
                  "explain": "Velocity dx/dt is the reciprocal derivative.",
                  "work": "\\(\\frac{dx}{dt}=\\frac1{3e^{-3x}}\\)"
                },
                {
                  "explain": "Simplify the reciprocal exponential.",
                  "work": "\\(\\frac{dx}{dt}=\\frac{e^{3x}}3\\)"
                },
                {
                  "explain": "Attach metres per second.",
                  "work": "\\(v=\\frac{e^{3x}}3\\text{ m s}^{-1}\\)"
                }
              ],
              "timeLimit": 60,
              "xp": 1,
              "meta": {
                "source": "Cheltenham Girls 2020 3U Trials & Solutions",
                "school": "Cheltenham Girls' High School",
                "year": 2020,
                "number": "11(e)(i)",
                "sourceFile": "/Users/andrewkim/Desktop/Paperdone/ Done/Trail E1/Cheltenham Girls 2020 3U Trials & Solutions.pdf",
                "sourcePages": "9"
              }
            },
            {
              "id": "cgs2020e1-q11e-ii",
              "type": "mc",
              "difficulty": "hard",
              "stem": "Using the formula \\(a=\\frac{d}{dx}\\left(\\frac12v^2\\right)\\), or otherwise, find the acceleration of the particle after 1 second.",
              "options": [
                "\\(\\frac13\\,\\text{m s}^{-2}\\)",
                "\\(\\frac{e^3}{3}\\,\\text{m s}^{-2}\\)",
                "\\(3\\,\\text{m s}^{-2}\\)",
                "\\(0\\,\\text{m s}^{-2}\\)"
              ],
              "answer": 0,
              "hint": "Use the velocity from the previous part, find x when t=1, then evaluate a=d(½v²)/dx.",
              "keyPoints": [
                {
                  "text": "after 1 second",
                  "note": "Substitute \\(t=1\\) into the given displacement-time relation."
                },
                {
                  "text": "\\(a=\\frac{d}{dx}\\left(\\frac12v^2\\right)\\)",
                  "note": "Express \\(v\\) as a function of \\(x\\) before differentiating."
                }
              ],
              "steps": [
                {
                  "explain": "At t=1, solve the given relation for x.",
                  "work": "\\(1=2-e^{-3x}\\Rightarrow x=0\\)"
                },
                {
                  "explain": "Use v=e^(3x)/3 and square it as required by the formula.",
                  "work": "\\(\\frac12v^2=\\frac{e^{6x}}{18}\\)"
                },
                {
                  "explain": "Differentiate with respect to x using the chain rule.",
                  "work": "\\(a=\\frac{d}{dx}(\\frac{e^{6x}}{18})=\\frac{e^{6x}}3\\)"
                },
                {
                  "explain": "Substitute x=0, the position at t=1.",
                  "work": "\\(a=\\frac{e^0}{3}=\\frac13\\)"
                },
                {
                  "explain": "State acceleration units.",
                  "work": "\\(a=\\frac13\\text{ m s}^{-2}\\)"
                }
              ],
