          "stem": "How many faces does a triangular prism have?",
          "options": [
            "\\(6\\)",
            "\\(4\\)",
            "\\(5\\)",
            "\\(3\\)"
          ],
          "answer": 2,
          "hint": "A triangular prism has 2 triangular ends and some rectangular sides connecting them.",
          "steps": [
            {
              "explain": "A triangular prism has 2 triangular faces (the ends) and 3 rectangular faces (the sides).",
              "work": "\\(2\\text{ triangles}+3\\text{ rectangles}\\)"
            },
            {
              "explain": "Add the faces together.",
              "work": "\\(2+3=5\\text{ faces}\\)"
            }
          ],
          "xp": 1
