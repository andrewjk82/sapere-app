              "work": "\\begin{aligned} 2 \\times 2 &= 4 \\\\ 4 \\times 2 &= 8 \\\\ 8 \\times 2 &= 16 \\\\ 16 \\times 2 &= 32 \\\\ 32 \\times 2 &= 64 \\end{aligned}"
