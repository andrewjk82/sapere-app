          "id": "y6-wn-q45",
          "type": "mc",
          "difficulty": "easy",
          "stem": "Find the value of $3^4$.",
          "options": [
            "89",
            "85",
            "81",
            "73"
          ],
          "answer": 2,
          "hint": "An exponent tells you how many times to multiply the base by itself: $3^4 = 3 \\times 3 \\times 3 \\times 3$.",
          "solution": "$3^4 = 3 \\times 3 \\times 3 \\times 3 = 9 \\times 9 = 81$.",
          "steps": [
            {
              "explain": "Write out the power as a repeated multiplication.",
              "work": "3^4 = 3 \\times 3 \\times 3 \\times 3"
            },
            {
              "explain": "Multiply step-by-step.",
              "work": "\\begin{aligned} 3 \\times 3 &= 9 \\\\ 9 \\times 3 &= 27 \\\\ 27 \\times 3 &= 81 \\end{aligned}"
            }
          ],
          "xp": 1
        },
