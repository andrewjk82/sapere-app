      "title": "Area of composite figures",
      "questions": [
        {
          "id": "y6-2ds-3-q1",
          "type": "mc",
          "difficulty": "hard",
          "stem": "Find the total area of the L-shaped figure shown, by dividing it into two rectangles.",
          "figure": {
            "svg": "fig:15c8630de4"
          },
          "options": [
            "\\(68\\text{ units}^2\\)",
            "\\(48\\text{ units}^2\\)",
            "\\(80\\text{ units}^2\\)",
            "\\(60\\text{ units}^2\\)"
          ],
          "answer": 0,
          "hint": "Split the L-shape into a left rectangle (full height) and a right rectangle (the upper part only), then add their areas.",
          "steps": [
            {
              "explain": "The left rectangle has width 6 and the full height, 8.",
              "work": "\\(\\text{Rectangle A}=6\\times8=48\\)"
            },
            {
              "explain": "The right rectangle has width 4 and height equal to the total height minus the step, \\(8-3=5\\).",
              "work": "\\(\\text{Rectangle B}=4\\times5=20\\)"
            },
            {
              "explain": "Add the two rectangle areas.",
              "work": "\\(48+20=68\\text{ units}^2\\)"
            }
          ],
          "xp": 3
        }
      ]
    },
