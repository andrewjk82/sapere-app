  "topics": [
    {
      "topicId": "y6-2ds-1",
      "code": "MA2-2DS-01",
      "title": "Transformations on a grid",
      "questions": [
        {
          "id": "y6-2ds-1-q1",
          "type": "mc",
          "difficulty": "easy",
          "stem": "A point at \\((2, 3)\\) is translated 4 units right and 1 unit down. What are its new coordinates?",
          "options": [
            "\\((6, 2)\\)",
            "\\((6, 4)\\)",
            "\\((-2, 2)\\)",
            "\\((2, 7)\\)"
          ],
          "answer": 0,
          "hint": "Moving right increases the \\(x\\)-coordinate; moving down decreases the \\(y\\)-coordinate.",
          "steps": [
            {
              "explain": "4 units right adds 4 to the \\(x\\)-coordinate.",
              "work": "\\(x=2+4=6\\)"
            },
            {
              "explain": "1 unit down subtracts 1 from the \\(y\\)-coordinate.",
              "work": "\\(y=3-1=2\\)"
            },
            {
              "explain": "Combine to state the new coordinates.",
              "work": "\\((6,2)\\)"
            }
          ],
          "xp": 1
        },
        {
          "id": "y6-2ds-1-q2",
          "type": "mc",
          "difficulty": "medium",
          "stem": "Point \\(A(2, 5)\\) is reflected in the \\(y\\)-axis. What are the coordinates of the image?",
          "options": [
            "\\((-2, 5)\\)",
            "\\((2, -5)\\)",
            "\\((-2, -5)\\)",
            "\\((5, 2)\\)"
          ],
          "answer": 0,
          "hint": "A reflection in the \\(y\\)-axis flips the sign of the \\(x\\)-coordinate only.",
          "steps": [
            {
              "explain": "Reflecting in the \\(y\\)-axis negates the \\(x\\)-coordinate and keeps \\(y\\) the same.",
              "work": "\\((2,5) \\to (-2,5)\\)"
            }
          ],
          "xp": 2
        }
      ]
    },
    {
      "topicId": "y6-2ds-2",
      "code": "MA2-2DS-01",
      "title": "Enlargement",
      "questions": [
        {
          "id": "y6-2ds-2-q1",
          "type": "mc",
          "difficulty": "easy",
          "stem": "A rectangle measuring \\(3\\text{ cm}\\) by \\(4\\text{ cm}\\) is enlarged by a scale factor of \\(2\\). What are the new dimensions?",
          "options": [
            "\\(6\\text{ cm}\\times8\\text{ cm}\\)",
            "\\(5\\text{ cm}\\times6\\text{ cm}\\)",
            "\\(3\\text{ cm}\\times8\\text{ cm}\\)",
            "\\(9\\text{ cm}\\times12\\text{ cm}\\)"
          ],
          "answer": 0,
          "hint": "Multiply each side length by the scale factor.",
          "steps": [
            {
              "explain": "Multiply both dimensions by the scale factor, 2.",
              "work": "\\(3\\times2=6, \\quad 4\\times2=8\\)"
            }
          ],
          "xp": 1
        },
        {
          "id": "y6-2ds-2-q2",
          "type": "mc",
          "difficulty": "hard",
          "stem": "A shape has an area of \\(12\\text{ cm}^2\\). It is enlarged by a scale factor of \\(3\\). What is the area of the enlarged shape?",
          "options": [
            "\\(108\\text{ cm}^2\\)",
            "\\(36\\text{ cm}^2\\)",
            "\\(15\\text{ cm}^2\\)",
            "\\(24\\text{ cm}^2\\)"
          ],
          "answer": 0,
          "hint": "When lengths are scaled by a factor \\(k\\), area is scaled by \\(k^2\\), not just \\(k\\).",
          "steps": [
            {
              "explain": "Area scales by the square of the length scale factor.",
              "work": "\\(\\text{Area scale factor}=3^2=9\\)"
            },
            {
              "explain": "Multiply the original area by this factor.",
              "work": "\\(12\\times9=108\\text{ cm}^2\\)"
            }
          ],
          "xp": 3
        }
      ]
    },
    {
      "topicId": "y6-2ds-3",
