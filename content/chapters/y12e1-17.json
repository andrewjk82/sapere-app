{
  "chapterId": "y12e1-17",
  "title": "Chapter 17: Binomial distributions",
  "year": "Year 12",
  "topics": [
    {
      "topicId": "y12e1-17A",
      "code": "17A",
      "title": "Binomial probability",
      "questions": [
        {
          "id": "bbhs2020e1-q12a",
          "type": "multipart",
          "stem": "Bags of lollipops are supposed to contain 50 lollipops. Production records indicate that 92% of bags contain 50 lollipops. A batch of 15 bags is sampled. If more than 2 bags do not contain exactly 50 lollipops, production is stopped.",
          "meta": {
            "source": "Blacktown Boys 2020 3U Trials & Solutions",
            "school": "Blacktown Boys' High School",
            "year": 2020,
            "number": "12(a)"
          },
          "parts": [
            {
              "id": "bbhs2020e1-q12a-i",
              "type": "mc",
              "difficulty": "medium",
              "timeLimit": 60,
              "stem": "Find the probability, correct to four decimal places, that exactly 2 of the 15 bags selected do not contain 50 lollipops.",
              "hint": "X ~ Bin(15, 0.08); P(X = 2) = C(15,2)(0.08)²(0.92)¹³.",
              "steps": [
                {
                  "explain": "Let \\(X\\) be the number of bags NOT containing 50. Each bag fails with probability \\(1-0.92=0.08\\).",
                  "work": "\\(X\\sim\\operatorname{Bin}(15,\\ 0.08)\\)"
                },
                {
                  "explain": "Binomial probability.",
                  "work": "\\(P(X=2)=\\binom{15}{2}(0.08)^2(0.92)^{13}=105\\times0.0064\\times0.33838\\dots\\)"
                },
                {
                  "explain": "Evaluate.",
                  "work": "\\(P(X=2)\\approx0.2273\\)"
                },
                {
                  "explain": "Make sure \\(p=0.08\\) (the 'failure' you are counting), not 0.92."
                }
              ],
              "xp": 1,
              "meta": {
                "source": "Blacktown Boys 2020 3U Trials & Solutions",
                "school": "Blacktown Boys' High School",
                "year": 2020,
                "number": "12(a)(i)"
              },
              "options": [
                "\\(0.0064\\)",
                "\\(0.1130\\)",
                "\\(0.0315\\)",
                "\\(0.2273\\)"
              ],
              "answer": 3,
              "keyPoints": [
                {
                  "text": "do not contain 50 lollipops",
                  "note": "Count the bags that fail: p = 1 − 0.92 = 0.08."
                }
              ]
            },
            {
              "id": "bbhs2020e1-q12a-ii",
              "type": "mc",
              "difficulty": "medium",
              "timeLimit": 60,
              "stem": "Find the probability, correct to four decimal places, that production is stopped.",
              "hint": "Use the complement: 1 − P(X ≤ 2).",
              "steps": [
                {
                  "explain": "Stopped when more than 2 bags fail: \\(P(X\\gt2)=1-P(X\\le2)\\).",
                  "work": "\\(P(X\\gt2)=1-\\left[P(0)+P(1)+P(2)\\right]\\)"
                },
                {
                  "explain": "Each term.",
                  "work": "\\(P(0)=0.92^{15}\\approx0.2863,\\quad P(1)=15(0.08)(0.92)^{14}\\approx0.3734,\\quad P(2)\\approx0.2273\\)"
                },
                {
                  "explain": "Subtract.",
                  "work": "\\(P(X\\gt2)\\approx1-0.8870=0.1130\\)"
                }
              ],
              "xp": 1,
              "meta": {
                "source": "Blacktown Boys 2020 3U Trials & Solutions",
                "school": "Blacktown Boys' High School",
                "year": 2020,
                "number": "12(a)(ii)"
              },
              "options": [
                "\\(0.2273\\)",
                "\\(0.3403\\)",
                "\\(0.1130\\)",
                "\\(0.8870\\)"
              ],
              "answer": 2,
              "keyPoints": [
                {
                  "text": "production is stopped",
                  "note": "'More than 2' = 1 − P(0) − P(1) − P(2)."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "topicId": "y12e1-17B",
      "code": "17B",
      "title": "Binomial distributions",
      "questions": [
        {
          "id": "bhhs2020e1-q12a",
          "type": "multipart",
          "stem": "The following table is the distribution of a random variable \\(X\\) where \\(X\\sim\\operatorname{Bin}(4,p)\\).\n\n| \\(x\\) | 0 | 1 | 2 | 3 | 4 |\n|---|---|---|---|---|---|\n| \\(P(X=x)\\) | 0.2401 | \\(a\\) | \\(b\\) | 0.0756 | 0.0081 |",
          "meta": {
            "source": "Baulkham Hills 2020 3U Trials & Solutions",
            "school": "Baulkham Hills High School",
            "year": 2020,
            "number": "12(a)"
          },
          "parts": [
            {
              "id": "bhhs2020e1-q12a-i",
              "type": "mc",
              "difficulty": "easy",
              "timeLimit": 60,
              "stem": "Use the known entries in the probability distribution table to calculate the value of \\(p\\).",
              "hint": "Use P(X = 4) = p⁴.",
              "steps": [
                {
                  "explain": "\\(P(X=4)\\) means all 4 trials succeed.",
                  "work": "\\(P(X=4)=\\binom44p^4(1-p)^0=p^4=0.0081\\)"
                },
                {
                  "explain": "Take the fourth root.",
                  "work": "\\(p=\\sqrt[4]{0.0081}=0.3\\)"
                },
                {
                  "explain": "Check with \\(P(X=0)=(0.7)^4=0.2401\\) ✓."
                }
              ],
              "xp": 1,
              "meta": {
                "source": "Baulkham Hills 2020 3U Trials & Solutions",
                "school": "Baulkham Hills High School",
                "year": 2020,
                "number": "12(a)(i)"
              },
              "options": [
                "\\(p=0.7\\)",
                "\\(p=0.0081\\)",
                "\\(p=0.09\\)",
                "\\(p=0.3\\)"
              ],
              "answer": 3,
              "keyPoints": [
                {
                  "text": "calculate the value of \\(p\\)",
                  "note": "P(X = 4) = p⁴ = 0.0081."
                }
              ]
            },
            {
              "id": "bhhs2020e1-q12a-ii",
              "type": "mc",
              "difficulty": "easy",
              "timeLimit": 60,
              "stem": "Find the values of \\(a\\) and \\(b\\)",
              "hint": "Use P(X = k) = C(4,k) pᵏ(1 − p)^(4−k) with p = 0.3.",
              "steps": [
                {
                  "explain": "\\(a=P(X=1)\\).",
                  "work": "\\(a=\\binom41(0.3)^1(0.7)^3=4\\times0.3\\times0.343=0.4116\\)"
                },
                {
                  "explain": "\\(b=P(X=2)\\).",
                  "work": "\\(b=\\binom42(0.3)^2(0.7)^2=6\\times0.09\\times0.49=0.2646\\)"
                },
                {
                  "explain": "Check: the probabilities add to 1.",
                  "work": "\\(0.2401+0.4116+0.2646+0.0756+0.0081=1\\ \\checkmark\\)"
                }
              ],
              "xp": 1,
              "meta": {
                "source": "Baulkham Hills 2020 3U Trials & Solutions",
                "school": "Baulkham Hills High School",
                "year": 2020,
                "number": "12(a)(ii)"
              },
              "options": [
                "\\(a=0.1029,\\ b=0.0441\\)",
                "\\(a=0.4116,\\ b=0.2744\\)",
                "\\(a=0.4116,\\ b=0.2646\\)",
                "\\(a=0.2646,\\ b=0.4116\\)"
              ],
              "answer": 2,
              "keyPoints": [
                {
                  "text": "Find the values of \\(a\\) and \\(b\\)",
                  "note": "a = P(X = 1), b = P(X = 2); don't forget the binomial coefficients 4 and 6."
                }
              ]
            },
            {
              "id": "bhhs2020e1-q12a-iii",
              "type": "mc",
              "difficulty": "easy",
              "timeLimit": 60,
              "stem": "Calculate \\(\\operatorname{Var}(X)\\).",
              "hint": "Var(X) = np(1 − p).",
              "steps": [
                {
                  "explain": "For a binomial distribution \\(\\operatorname{Var}(X)=np(1-p)\\).",
                  "work": "\\(\\operatorname{Var}(X)=4\\times0.3\\times0.7=0.84\\)"
                },
                {
                  "explain": "1.2 is the mean \\(np\\); 0.9165 is the standard deviation \\(\\sqrt{0.84}\\)."
                }
              ],
              "xp": 1,
              "meta": {
                "source": "Baulkham Hills 2020 3U Trials & Solutions",
                "school": "Baulkham Hills High School",
                "year": 2020,
                "number": "12(a)(iii)"
              },
              "options": [
                "\\(0.9165\\)",
                "\\(0.84\\)",
                "\\(1.2\\)",
                "\\(0.21\\)"
              ],
              "answer": 1,
              "keyPoints": [
                {
                  "text": "\\(\\operatorname{Var}(X)\\)",
                  "note": "For Bin(n, p): variance = npq."
                }
              ]
            },
            {
              "id": "bhhs2020e1-q12a-iv",
              "type": "mc",
              "difficulty": "easy",
              "timeLimit": 60,
              "stem": "Find \\(P(X\\ge3)\\).",
              "hint": "Add P(X = 3) and P(X = 4).",
              "steps": [
                {
                  "explain": "\\(X\\ge3\\) means \\(X=3\\) or \\(X=4\\). Add those entries.",
                  "work": "\\(P(X\\ge3)=0.0756+0.0081=0.0837\\)"
                },
                {
                  "explain": "0.9163 is \\(P(X\\le2)\\), the complement."
                }
              ],
              "xp": 1,
