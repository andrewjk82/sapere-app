      "questions": [
        {
          "id": "ascham2020e1-q9",
          "type": "mc",
          "difficulty": "medium",
          "stem": "The graph of \\(y=\\cos^{-1}(2x)\\) is dilated horizontally by a factor of 4 and then translated vertically by 3 units. What is its new equation?",
          "options": [
            "\\(y=\\cos^{-1}(2x/4+3)\\)",
            "\\(y=\\cos^{-1}(2x/4)+3\\)",
            "\\(y=\\cos^{-1}(8x)+3\\)",
            "\\(y=\\cos^{-1}(8x+3)\\)"
          ],
          "answer": 1,
          "hint": "A horizontal dilation by factor 4 replaces x by x/4 in the entire original function. Add 3 outside the function for the vertical translation.",
          "keyPoints": [
            {
              "text": "dilated horizontally by a factor of 4",
              "note": "Replace x by x/4 everywhere in the original function."
            },
            {
              "text": "translated vertically by 3 units",
              "note": "Add 3 after applying the inverse cosine."
            }
          ],
          "steps": [
            {
              "explain": "Write the original function as f(x)=cos⁻¹(2x). A horizontal dilation by 4 gives f(x/4).",
              "work": "\\(f(x/4)=\\cos^{-1}(2\\cdot\\frac{x}{4})\\)"
            },
            {
              "explain": "Simplify the input and then shift the output up by 3.",
              "work": "\\(y=f(x/4)+3=\\cos^{-1}(\\frac{2x}{4})+3\\)"
            },
            {
              "explain": "The horizontal factor changes the input; the vertical translation is outside the inverse-cosine function.",
              "work": "\\(\\boxed{y=\\cos^{-1}(\\frac{2x}{4})+3}\\)"
            }
          ],
          "solution": "Correct answer: \\(y=\\cos^{-1}(2x/4)+3\\).",
          "timeLimit": 60,
          "xp": 1,
          "meta": {
            "source": "Ascham 2020 3U Trial",
            "examPaper": "Ascham 2020 3U Trial & Solutions"
          }
        }
      ]
    },
