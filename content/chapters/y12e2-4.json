        {
          "id": "abbotsleigh2025-ext2-q16a_ii",
          "type": "mc",
          "difficulty": "medium",
          "timeLimit": 60,
          "stem": "For \\(I_k=\\int_0^{1/4}x^ke^{-x}dx\\), which is the correct recurrence?",
          "hint": "Integrate the derivative of \\(x^{k+1}e^{-x}\\) over the interval.",
          "solution": "The first recurrence.",
          "steps": [
            {
              "explain": "Differentiate the product.",
              "work": "\\(\\frac{d}{dx}(x^{k+1}e^{-x})=(k+1)x^ke^{-x}-x^{k+1}e^{-x}.\\)"
            },
            {
              "explain": "Integrate and evaluate endpoints.",
              "work": "\\((k+1)I_k-I_{k+1}=4^{-k-1}e^{-1/4}.\\)"
            },
            {
              "explain": "Rearrange into the requested form.",
              "work": "\\(kI_k=I_{k+1}-I_k+4^{-k-1}e^{-1/4}.\\)"
