      "title": "Substitution",
      "questions": [
        {
          "id": "abbotsleigh2025-ext2-q10",
          "type": "mc",
          "difficulty": "medium",
          "timeLimit": 60,
          "stem": "Consider \\(I=\\int_0^\\pi x\\sin x\\,dx\\). Using \\(x=\\pi-y\\), what is the value of I?",
          "hint": "Substitute both the expression for x and the differential dx, then reverse the limits caused by the negative sign.",
          "solution": "\\(I=\\frac\\pi2\\int_0^\\pi\\sin y\\,dy=\\pi\\)",
          "steps": [
            {
              "explain": "Substitute x=π−y and reverse the bounds.",
              "work": "\\(I=\\int_0^\\pi(\\pi-y)\\sin y\\,dy.\\\\)"
            },
            {
              "explain": "Use the symmetry y↔π−y to relate the y sin y integral to I.",
              "work": "\\(\\int_0^\\pi y\\sin y\\,dy=\\int_0^\\pi(\\pi-y)\\sin y\\,dy=I.\\\\)"
            },
            {
              "explain": "Add the two equal integrals to get twice I.",
              "work": "\\(2I=\\pi\\int_0^\\pi\\sin y\\,dy,\\quad I=\\frac\\pi2\\int_0^\\pi\\sin y\\,dy=\\pi.\\\\)"
            }
          ],
          "xp": 1,
          "meta": {
            "source": "Abbotsleigh 2025 4U Trials & Solutions",
            "school": "Abbotsleigh"
          },
          "options": [
            "\\(\\int_{-\\pi/2}^{\\pi/2}\\pi\\sin y\\,dy\\)",
            "\\(\\pi\\int_0^\\pi\\sin y\\,dy\\)",
            "\\(\\frac{\\pi}{2}\\int_0^\\pi\\sin y\\,dy\\)",
            "\\(\\int_0^\\pi\\sin y\\,dy\\)"
          ],
          "answer": 2,
          "keyPoints": [
            {
              "text": "Consider \\(I=\\int_0^\\pi x\\sin x\\,dx\\)",
              "note": "Substitute both the expression for x and the differential dx, then reverse the limits caused by the negative sign."
            }
          ]
        },
        {
          "id": "abbotsleigh2025-ext2-q14a",
          "type": "mc",
          "difficulty": "medium",
          "timeLimit": 60,
          "stem": "Evaluate \\(\\int_{\\pi/2}^{\\pi}\\frac{x}{1-x\\cot x}\\,dx\\).",
          "hint": "Rewrite the denominator using sine, then differentiate \\(u=\\sin x-x\\cos x\\).",
          "solution": "\\(\\ln\\pi\\)",
          "steps": [
            {
              "explain": "Rewrite the integrand.",
              "work": "\\(1-x\\cot x=\\frac{\\sin x-x\\cos x}{\\sin x}.\\)"
            },
            {
              "explain": "Choose a substitution.",
              "work": "Let \\(u=\\sin x-x\\cos x\\); then \\(du=x\\sin x\\,dx.\\)"
            },
            {
              "explain": "Transform and evaluate.",
              "work": "The integral is \\(\\int du/u=[\\ln u]_{x=\\pi/2}^{x=\\pi}=\\ln\\pi-\\ln1=\\ln\\pi.\\)"
            }
          ],
          "xp": 1,
          "meta": {
            "source": "Abbotsleigh 2025 4U Trials & Solutions",
            "school": "Abbotsleigh"
          },
          "options": [
            "\\(\\ln\\pi\\)",
            "\\(\\ln2\\)",
            "\\(\\pi\\ln2\\)",
            "\\(\\ln(\\pi/2)\\)"
          ],
          "answer": 0,
          "keyPoints": [
            {
              "text": "Evaluate \\(\\int_{\\pi/2}^{\\pi}\\frac{x}{1-x\\cot x}\\,dx\\)",
              "note": "Rewrite the denominator using sine, then differentiate \\(u=\\sin x-x\\cos x\\)."
            }
          ]
        }
      ]
