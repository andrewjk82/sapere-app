          "type": "mc",
          "difficulty": "medium",
          "timeLimit": 60,
          "stem": "Evaluate \\(\\int_0^1\\ln(x^2+1)\\,dx\\).",
          "hint": "Use integration by parts with the logarithm as the factor to differentiate.",
          "solution": "\\(\\ln2-2+\\frac\\pi2\\)",
          "steps": [
            {
              "explain": "Choose parts.",
              "work": "Let \\(u=\\ln(1+x^2),\\ dv=dx\\). Then \\(du=\\frac{2x}{1+x^2}dx,\\ v=x.\\)"
            },
            {
              "explain": "Apply integration by parts and simplify.",
              "work": "\\(I=[x\\ln(1+x^2)]_0^1-\\int_0^1\\frac{2x^2}{1+x^2}dx=\\ln2-2+2\\int_0^1\\frac{1}{1+x^2}dx.\\)"
            },
            {
              "explain": "Evaluate the arctangent integral.",
              "work": "\\(I=\\ln2-2+2[\\arctan x]_0^1=\\ln2-2+\\frac\\pi2.\\)"
            }
          ],
          "xp": 1,
          "meta": {
            "source": "Abbotsleigh 2025 4U Trials & Solutions",
            "school": "Abbotsleigh"
          },
          "options": [
            "\\(\\ln2-2+\\frac\\pi2\\)",
            "\\(\\ln2+2-\\frac\\pi2\\)",
            "\\(2\\ln2-1\\)",
            "\\(\\ln2-1+\\frac\\pi2\\)"
          ],
          "answer": 0,
          "keyPoints": [
            {
              "text": "Evaluate \\(\\int_0^1\\ln(x^2+1)\\,dx\\)",
              "note": "Use integration by parts with the logarithm as the factor to differentiate."
            }
          ]
        },
        {
          "id": "abbotsleigh2025-ext2-q16a_i",
          "type": "mc",
          "difficulty": "medium",
          "timeLimit": 60,
          "stem": "Let \\(I_n=\\int_0^{1/4}\\frac{x^n}{e^x}\\,dx\\). Evaluate \\(I_1\\).",
          "hint": "Integrate \\(xe^{-x}\\) by parts on the stated interval.",
          "solution": "\\(1-\\frac5{4e^{1/4}}\\)",
          "steps": [
            {
              "explain": "Choose integration by parts.",
              "work": "\\(u=x,\\ dv=e^{-x}dx;\\quad v=-e^{-x}.\\)"
            },
            {
              "explain": "Evaluate the boundary term and remaining integral.",
              "work": "\\(I_1=[-xe^{-x}]_0^{1/4}+\\int_0^{1/4}e^{-x}dx.\\)"
            },
            {
              "explain": "Simplify.",
              "work": "\\(-\\frac1{4e^{1/4}}+1-e^{-1/4}+?\\) compute boundary carefully; \\(I_1=1-\\frac{5}{4e^{1/4}}.\\)"
