      "questions": [
        {
          "id": "cranbrook2020e2-q12ci",
          "type": "mc",
          "stem": "Let \\(I=\\int_0^{\\frac{\\pi}{2}}\\dfrac{2}{3+5\\cos x}\\,dx\\). Using the substitution \\(t=\\tan\\dfrac{x}{2}\\) show that \\(I=\\int_0^{1}\\dfrac{2}{4-t^2}\\,dt\\).",
          "difficulty": "hard",
          "options": [
            "\\(\\int_0^1\\dfrac{2}{4-t^2}\\,dt\\)",
            "\\(\\int_0^1\\dfrac{2}{4+t^2}\\,dt\\)",
            "\\(\\int_0^{\\frac{\\pi}{2}}\\dfrac{2}{4-t^2}\\,dt\\)",
            "\\(\\int_0^1\\dfrac{4}{4-t^2}\\,dt\\)"
          ],
          "answer": 0,
          "hint": "The t-formulae: \\(\\cos x=\\dfrac{1-t^2}{1+t^2}\\) and \\(dx=\\dfrac{2\\,dt}{1+t^2}\\). Substitute into the denominator and the differential, simplify, and change the limits.",
          "steps": [
            {
              "explain": "Substitution rules for \\(t=\\tan\\dfrac{x}{2}\\).",
              "work": "\\(\\cos x=\\dfrac{1-t^2}{1+t^2},\\qquad dx=\\dfrac{2}{1+t^2}\\,dt\\)"
            },
            {
              "explain": "Change the limits.",
              "work": "\\(x=0\\;\\Rightarrow\\;t=\\tan0=0;\\qquad x=\\dfrac{\\pi}{2}\\;\\Rightarrow\\;t=\\tan\\dfrac{\\pi}{4}=1\\)"
            },
            {
              "explain": "Simplify the denominator \\(3+5\\cos x\\).",
              "work": "\\(3+5\\cdot\\dfrac{1-t^2}{1+t^2}=\\dfrac{3(1+t^2)+5(1-t^2)}{1+t^2}=\\dfrac{8-2t^2}{1+t^2}\\)"
            },
            {
              "explain": "Substitute into the integral and combine.",
              "work": "\\(I=\\int_0^1\\dfrac{2}{\\left(\\dfrac{8-2t^2}{1+t^2}\\right)}\\times\\dfrac{2}{1+t^2}\\,dt=\\int_0^1\\dfrac{2(1+t^2)}{8-2t^2}\\times\\dfrac{2}{1+t^2}\\,dt\\)"
            },
            {
              "explain": "The factors \\((1+t^2)\\) cancel.",
              "work": "\\(I=\\int_0^1\\dfrac{4}{8-2t^2}\\,dt=\\int_0^1\\dfrac{2}{4-t^2}\\,dt\\) → <span style=\"color:#047857;font-weight:700\">A</span>"
            }
          ],
          "keyPoints": [
            {
              "text": "Using the substitution",
              "note": "Use the t-formulae and change the limits."
            }
          ],
          "timeLimit": 60,
          "xp": 1,
          "meta": {
            "source": "Cranbrook School 2020 Mathematics Extension 2 HSC Trial Examination (Assessment Task 3)",
            "school": "Cranbrook School",
            "grade": "12",
            "origin": "teacher"
          }
        },
        {
          "id": "girr2020-y12e2-q12b",
          "type": "mc",
          "stem": "Find \\(\\displaystyle\\int\\dfrac{1}{\\sin x-\\cos x-1}\\,dx\\).",
          "difficulty": "hard",
          "options": [
            "\\(\\ln\\left|\\tan\\dfrac{x}{2}+1\\right|+C\\)",
            "\\(2\\ln\\left|\\tan\\dfrac{x}{2}-1\\right|+C\\)",
            "\\(\\ln\\left|\\tan\\dfrac{x}{2}-1\\right|+C\\)",
            "\\(\\dfrac{1}{2}\\ln\\left|\\tan\\dfrac{x}{2}-1\\right|+C\\)"
          ],
          "answer": 2,
          "hint": "Use the \\(t\\)-substitution \\(t=\\tan\\dfrac{x}{2}\\): \\(\\sin x=\\dfrac{2t}{1+t^{2}}\\), \\(\\cos x=\\dfrac{1-t^{2}}{1+t^{2}}\\), \\(dx=\\dfrac{2\\,dt}{1+t^{2}}\\).",
          "steps": [
            {
              "explain": "Let \\(t=\\tan\\dfrac{x}{2}\\). Then \\(\\sin x=\\dfrac{2t}{1+t^{2}}\\), \\(\\cos x=\\dfrac{1-t^{2}}{1+t^{2}}\\) and \\(dx=\\dfrac{2}{1+t^{2}}dt\\).",
              "work": "\\(\\sin x=\\dfrac{2t}{1+t^{2}},\\ \\cos x=\\dfrac{1-t^{2}}{1+t^{2}},\\ dx=\\dfrac{2\\,dt}{1+t^{2}}\\)"
            },
            {
              "explain": "Simplify the denominator over \\(1+t^{2}\\). Write \\(1=\\dfrac{1+t^{2}}{1+t^{2}}\\).",
              "work": "\\(\\sin x-\\cos x-1=\\dfrac{2t-(1-t^{2})-(1+t^{2})}{1+t^{2}}=\\dfrac{2t-2}{1+t^{2}}\\)"
            },
            {
              "explain": "Substitute into the integral and cancel the factor \\(1+t^{2}\\).",
              "work": "\\(\\int\\dfrac{1+t^{2}}{2t-2}\\cdot\\dfrac{2}{1+t^{2}}\\,dt=\\int\\dfrac{2}{2t-2}\\,dt=\\int\\dfrac{1}{t-1}\\,dt\\)"
            },
            {
              "explain": "Integrate and substitute back \\(t=\\tan\\dfrac{x}{2}\\).",
              "work": "\\(=\\ln|t-1|+C=\\ln\\left|\\tan\\dfrac{x}{2}-1\\right|+C\\)"
            },
            {
              "explain": "Check by differentiating: using the chain rule, the derivative simplifies to the original integrand (shown below). A factor of one half in front of the logarithm would NOT give the right derivative.",
              "work": "\\(\\dfrac{d}{dx}\\ln\\left|\\tan\\dfrac{x}{2}-1\\right|=\\dfrac{\\dfrac{1}{2}\\sec^{2}\\dfrac{x}{2}}{\\tan\\dfrac{x}{2}-1}=\\dfrac{1}{\\sin x-(1+\\cos x)}\\)"
            },
            {
              "explain": "So the correct choice is option <span style=\"color:#047857;font-weight:700\">C</span>.",
              "work": ""
            }
          ],
          "keyPoints": [
            {
              "text": "Find",
              "note": "t-substitution; simplify the denominator carefully."
            }
          ],
          "timeLimit": 60,
          "xp": 1,
          "meta": {
            "source": "Girraween High School 2020 Trial HSC Examination Mathematics Extension 2",
            "school": "Girraween High School",
            "grade": "12",
            "origin": "teacher"
          }
        },
        {
          "id": "gosford2020-e2-q13d",
          "type": "mc",
          "stem": "Evaluate \\(\\displaystyle\\int_{0}^{\\frac{\\pi}{2}}\\dfrac{dx}{3+5\\cos x}\\).",
          "difficulty": "hard",
          "options": [
            "\\(\\dfrac{\\ln3}{4}\\)",
            "\\(\\dfrac{\\ln3}{2}\\)",
            "\\(\\dfrac{\\ln3}{8}\\)",
            "\\(\\dfrac{\\ln2}{4}\\)"
          ],
          "answer": 0,
          "hint": "For \\(\\dfrac{1}{a+b\\cos x}\\) use the \\(t\\)-substitution \\(t=\\tan\\dfrac{x}{2}\\): \\(\\cos x=\\dfrac{1-t^{2}}{1+t^{2}}\\) and \\(dx=\\dfrac{2\\,dt}{1+t^{2}}\\). Change the limits too.",
          "steps": [
            {
              "explain": "Let \\(t=\\tan\\dfrac{x}{2}\\). Then \\(\\cos x=\\dfrac{1-t^{2}}{1+t^{2}}\\) and \\(dx=\\dfrac{2\\,dt}{1+t^{2}}\\). Limits: \\(x=0\\Rightarrow t=0\\); \\(x=\\dfrac{\\pi}{2}\\Rightarrow t=\\tan\\dfrac{\\pi}{4}=1\\).",
              "work": "\\(x:\\ 0\\to\\dfrac{\\pi}{2}\\quad\\Rightarrow\\quad t:\\ 0\\to1\\)"
            },
            {
              "explain": "Substitute into the integral.",
              "work": "\\(\\displaystyle\\int_{0}^{1}\\dfrac{\\dfrac{2\\,dt}{1+t^{2}}}{3+5\\left(\\dfrac{1-t^{2}}{1+t^{2}}\\right)}\\)"
            },
            {
              "explain": "Multiply top and bottom by \\(1+t^{2}\\) to clear the small fractions. Denominator: \\(3(1+t^{2})+5(1-t^{2})=8-2t^{2}\\).",
              "work": "\\(=\\displaystyle\\int_{0}^{1}\\dfrac{2\\,dt}{8-2t^{2}}=\\displaystyle\\int_{0}^{1}\\dfrac{dt}{4-t^{2}}\\)"
            },
            {
              "explain": "Partial fractions: \\(\\dfrac{1}{4-t^{2}}=\\dfrac{1}{(2-t)(2+t)}=\\dfrac{1}{4}\\left(\\dfrac{1}{2-t}+\\dfrac{1}{2+t}\\right)\\).",
              "work": "\\(\\displaystyle\\int_{0}^{1}\\dfrac{1}{4}\\left(\\dfrac{1}{2-t}+\\dfrac{1}{2+t}\\right)dt\\)"
            },
            {
              "explain": "Integrate (note \\(\\int\\dfrac{dt}{2-t}=-\\ln|2-t|\\)) and substitute the limits.",
              "work": "\\(=\\dfrac{1}{4}\\left[-\\ln|2-t|+\\ln|2+t|\\right]_{0}^{1}=\\dfrac{1}{4}\\left[\\ln\\dfrac{2+t}{2-t}\\right]_{0}^{1}\\)"
            },
            {
              "explain": "At \\(t=1\\): \\(\\ln\\dfrac{3}{1}=\\ln3\\). At \\(t=0\\): \\(\\ln1=0\\).",
              "work": "\\(=\\dfrac{1}{4}(\\ln3-0)=\\dfrac{\\ln3}{4}\\)"
            },
            {
              "explain": "Check size: the integrand rises from \\(\\dfrac{1}{8}\\) to \\(\\dfrac{1}{3}\\) over an interval of length about 1.57, so the answer is about \\(0.2\\times1.57\\approx0.3\\); \\(\\dfrac{\\ln3}{4}\\approx0.275\\) ✓.",
              "work": ""
            },
            {
              "explain": "So the correct choice is option <span style=\"color:#047857;font-weight:700\">A</span>.",
              "work": ""
            }
          ],
          "keyPoints": [
            {
              "text": "Evaluate \\(\\displaystyle\\int_{0}^{\\frac{\\pi}{2}}\\dfrac{dx}{3+5\\cos x}\\)",
              "note": "t = tan(x/2): cos x = (1 − t²) ÷ (1 + t²)."
            }
