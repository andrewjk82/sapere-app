        {
          "id": "y11a-6k-q2c",
          "type": "mc",
          "difficulty": "easy",
          "stem": "Simplify the expression: \\\\(\\\\frac{\\\\tan \\\\theta}{\\\\sec \\\\theta}\\\\)",
          "options": [
            "\\(\\cot \\theta\\)",
            "\\(\\cos \\theta\\)",
            "\\(\\text{cosec} \\theta\\)",
            "\\(\\sin \\theta\\)"
          ],
          "answer": 3,
          "hint": "Rewrite both \\(\\tan \\theta\\) and \\(\\sec \\theta\\) in terms of sine and cosine.",
          "solution": "\\(\\sin \\theta\\)",
          "steps": [
            {
              "explain": "Express both \\(\\tan \\theta\\) and \\(\\sec \\theta\\) in terms of sine and cosine.",
              "work": "\\(\\tan \\theta = \\frac{\\sin \\theta}{\\cos \\theta}\\) and \\(\\sec \\theta = \\frac{1}{\\cos \\theta}\\)"
            },
            {
              "explain": "Substitute these into the expression.",
              "work": "\\(\\frac{\\frac{\\sin \\theta}{\\cos \\theta}}{\\frac{1}{\\cos \\theta}}\\)"
            },
            {
              "explain": "Multiply the numerator by the reciprocal of the denominator.",
              "work": "\\(\\frac{\\sin \\theta}{\\cos \\theta} \\times \\frac{\\cos \\theta}{1} = \\sin \\theta\\)"
            }
          ],
          "timeLimit": 60
        },
        {
          "id": "y11a-6k-q3b",
          "type": "review",
          "difficulty": "medium",
          "stem": "Simplify the expression: \\\\(\\\\cot \\\\theta \\\\sec \\\\theta\\\\)",
          "answer": "\\(\\text{cosec } \\theta\\)",
          "options": [
            "\\(\\text{cosec } \\theta\\)",
            "\\(\\sin \\theta\\)",
            "\\(\\cos \\theta\\)",
            "\\(\\tan \\theta\\)"
          ],
          "hint": "Rewrite cotangent and secant in terms of sine and cosine.",
          "solution": "\\(\\text{cosec } \\theta\\)",
          "steps": [
            {
              "explain": "Express both \\(\\cot \\theta\\) and \\(\\sec \\theta\\) in terms of sine and cosine.",
              "work": "\\(\\cot \\theta = \\frac{\\cos \\theta}{\\sin \\theta}\\) and \\(\\sec \\theta = \\frac{1}{\\cos \\theta}\\)"
            },
            {
              "explain": "Substitute these into the expression.",
              "work": "\\(\\frac{\\cos \\theta}{\\sin \\theta} \\times \\frac{1}{\\cos \\theta}\\)"
            },
            {
              "explain": "Cancel out \\(\\cos \\theta\\) and use the reciprocal identity.",
              "work": "\\(\\frac{1}{\\sin \\theta} = \\text{cosec } \\theta\\)"
            }
          ],
          "manual": true,
          "timeLimit": 90
        },
        {
