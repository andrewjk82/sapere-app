          "type": "mc",
          "difficulty": "easy",
          "stem": "The degree of the polynomial \\(P(x) = 6x^4-4x^3+3x^5-x+1\\) is:",
          "options": [
            "\\(5\\)",
            "\\(3\\)",
            "\\(6\\)",
            "\\(4\\)"
          ],
          "answer": 0,
          "hint": "The degree is the highest power of \\(x\\) appearing — rewrite the terms in descending order first.",
          "steps": [
            {
              "explain": "Rewrite the terms in descending order of power.",
              "work": "\\(P(x) = 3x^5+6x^4-4x^3-x+1\\)"
            },
            {
              "explain": "The degree is the highest power present.",
              "work": "Leading term is \\(3x^5\\) \\(\\Rightarrow\\) degree \\(=5\\)"
            }
          ],
          "meta": {
