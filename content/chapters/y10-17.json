          "id": "abb-y10-2025-t4-e1-q3",
          "type": "mc",
          "difficulty": "medium",
          "stem": "Solve 3x³ − 6x² − 15x + 18 = 0.",
          "options": [
            "x=−2,1,3",
            "x=−3,1,2",
            "x=−2,−1,3",
            "x=−1,2,3"
          ],
          "answer": 0,
          "hint": "Factor out 3, test x=1, and factor the remaining quadratic.",
          "steps": [
            {
              "explain": "Remove the common factor 3.",
              "work": "x³−2x²−5x+6=0"
            },
            {
              "explain": "Test x=1 and divide by (x−1).",
              "work": "1−2−5+6=0;\nx³−2x²−5x+6=(x−1)(x²−x−6)"
            },
            {
              "explain": "Factor and solve.",
              "work": "(x−1)(x−3)(x+2)=0; x=1,3,−2"
            }
          ],
          "keyPoints": [
            {
              "text": "Solve 3x³ − 6x² − 15x + 18 = 0",
              "note": "Take out 3, find a simple root, then factor the remaining quadratic."
            }
