      "title": "Combining transformations",
      "questions": [
        {
          "id": "cgs2020e1-q7",
          "type": "mc",
          "difficulty": "medium",
          "stem": "The function \\(y=\\sin 2x\\) is shown in the diagram. If this function is transformed using the following steps: (1) reflected about the x-axis, (2) vertically translated 1 unit down, and (3) dilated horizontally by a scale factor of 2, which equation represents the transformed function?",
          "options": [
            "\\(y=-(\\sin x+1)\\)",
            "\\(x=2(\\sin(2y)-1)\\)",
            "\\(y=-(\\sin(4x))+2\\)",
            "\\(y=-2\\sin(2x)-1\\)"
          ],
          "answer": 0,
          "hint": "Apply the transformations in order. A horizontal dilation by 2 replaces x with x/2 in the current function.",
          "keyPoints": [
            {
              "text": "\\(y=\\sin 2x\\)",
              "note": "Keep the original input x inside the function until the horizontal dilation."
            },
            {
              "text": "dilated horizontally by a scale factor of 2",
              "note": "A horizontal scale factor of 2 changes the input to \\(x/2\\)."
            }
          ],
          "steps": [
