          "id": "jr2013-q8",
          "type": "mc",
          "stem": "The number of terms in the series \\(\\displaystyle\\sum_{r=28}^{57}(2r+1)\\) is:",
          "options": [
            "\\(28\\)",
            "\\(29\\)",
            "\\(57\\)",
            "\\(30\\)"
          ],
          "answer": 3,
          "hint": "The number of integers from 28 to 57 inclusive is \\(57-28+1\\).",
          "steps": [
            {
              "explain": "The number of terms in a sum from \\(r=a\\) to \\(r=b\\) inclusive is \\(b-a+1\\).",
              "work": "Number of terms \\(= 57-28+1\\)"
            },
            {
              "explain": "Evaluate.",
              "work": "\\(= 30\\)"
            }
          ],
