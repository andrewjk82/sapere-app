    {
      "topicId": "y12e1-10A",
      "code": "10A",
      "title": "Projectile motion — the time equations",
      "questions": [
        {
          "id": "ascham2020e1-q11c",
          "type": "multipart",
          "stem": "Zara is testing a batch of homemade bullets on her shooting range.\nShe holds her rifle at shoulder height (170 cm above the ground) and shoots horizontally with an initial speed of 360 m/s at a target 100m away.\nAssume acceleration due to gravity is 10m/s².",
          "meta": {
            "source": "Ascham 2020 3U Trial",
            "examPaper": "Ascham 2020 3U Trial & Solutions",
            "school": "Ascham",
            "year": 2020,
            "number": "11(c)"
          },
          "parts": [
            {
              "id": "ascham2020e1-q11c-i",
              "type": "mc",
              "difficulty": "easy",
              "timeLimit": 60,
              "stem": "Find expressions for \\(\\dot{y}\\) and \\(\\dot{x}\\).",
              "hint": "Horizontal shot: initial vertical velocity is 0.",
              "steps": [
                {
                  "explain": "Horizontally there is no acceleration; vertically the acceleration is \\(-10\\).",
                  "work": "\\(\\ddot x=0,\\qquad\\ddot y=-10\\)"
                },
                {
                  "explain": "Integrate. The shot is horizontal, so at \\(t=0\\): \\(\\dot x=360\\) and \\(\\dot y=0\\).",
                  "work": "\\(\\dot x=360,\\qquad\\dot y=-10t\\)"
                }
              ],
              "xp": 1,
              "meta": {
                "source": "Ascham 2020 3U Trial",
                "examPaper": "Ascham 2020 3U Trial & Solutions",
                "school": "Ascham",
                "year": 2020,
                "number": "11(c)(i)"
              },
              "options": [
                "\\(\\dot x=360,\\ \\dot y=360-10t\\)",
                "\\(\\dot x=0,\\ \\dot y=-10t\\)",
                "\\(\\dot x=360t,\\ \\dot y=-5t^2\\)",
                "\\(\\dot x=360,\\ \\dot y=-10t\\)"
              ],
              "answer": 3,
              "keyPoints": [
                {
                  "text": "Find expressions for",
                  "note": "The shot is horizontal, so horizontally means ẏ = 0 and ẋ = 360 at t = 0."
                }
              ]
            },
            {
              "id": "ascham2020e1-q11c-ii",
              "type": "mc",
              "difficulty": "easy",
              "timeLimit": 60,
              "stem": "Find expressions for \\(y\\) and \\(x\\).",
              "hint": "Integrate ẋ and ẏ; the starting height is 1.7 m.",
              "steps": [
                {
                  "explain": "Integrate again, with the origin on the ground below the rifle: \\(x=0\\) and \\(y=1.7\\) (170 cm = 1.7 m) at \\(t=0\\).",
