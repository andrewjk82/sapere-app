        {
          "id": "abbotsleigh2020-ext1-q14ciii",
          "type": "mc",
          "difficulty": "hard",
          "stem": "A stone follows \\(y=\\sqrt3x-\\frac{4x^2}{45}\\) and lands on the 45° downward slope \\(y=-x\\). How far down the slope from the origin does it land?",
          "options": [
            "\\(\\frac{45\\sqrt{2}(1+\\sqrt{3})}{4}\\text{ m}\\)",
            "\\(\\frac{45(1+\\sqrt{3})}{4}\\text{ m}\\)",
            "\\(\\frac{45\\sqrt{2}(\\sqrt{3}-1)}{4}\\text{ m}\\)",
            "\\(\\frac{45\\sqrt{3}}{4}\\text{ m}\\)"
          ],
          "answer": 0,
          "hint": "Set the trajectory equal to the slope to find the impact x-coordinate; convert horizontal distance into distance along a 45° line.",
          "keyPoints": [
            {
              "text": "45° downward slope",
              "note": "The impact point is where the projectile path intersects this line."
            },
            {
              "text": "How far down the slope",
              "note": "A 45° slope distance is \\(x/\\cos45^\\circ=x\\sqrt{2}\\), not just x."
            }
          ],
          "steps": [
            {
              "explain": "Set the projectile path equal to the slope equation.",
              "work": "\\(\\sqrt3x-\\frac{4x^2}{45}=-x\\Rightarrow x\\left(\\sqrt3+1-\\frac{4x}{45}\right)=0\\)"
            },
            {
              "explain": "Use the nonzero intersection to get the horizontal coordinate.",
              "work": "\\(x=\\frac{45}{4}(1+\\sqrt3)\\)"
            },
            {
              "explain": "Convert horizontal distance to length along the 45° slope.",
              "work": "\\(s=\\frac{x}{\\cos45^\\circ}=x\\sqrt{2}=\\frac{45\\sqrt2(1+\\sqrt3)}4\\text{ m}\\approx43.5\\text{ m}\\)"
            }
          ],
          "solution": "\\(\\frac{45\\sqrt{2}(1+\\sqrt{3})}{4}\\text{ m}\\)",
          "timeLimit": 60,
          "xp": 1,
          "meta": {
            "source": "Abbotsleigh 2020 Trial Examination",
            "sourceFile": "/Users/andrewkim/Downloads/Abbotsleigh 2020.pdf",
            "school": "Abbotsleigh",
            "year": 2020
          },
          "figure": {
