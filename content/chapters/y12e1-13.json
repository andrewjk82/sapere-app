    {
      "topicId": "y12e1-13E",
      "code": "13E",
      "title": "Applications of differential equations",
      "questions": [
        {
          "id": "abbotsleigh2020-ext1-q13bii",
          "type": "mc",
          "difficulty": "hard",
          "stem": "Soup cools according to \\(T=21+75e^{-kt}\\), where t is minutes after removal from the stove. It is 87°C after 5 minutes. How much longer after that measurement must Miriam wait for it to reach 70°C?",
          "options": [
            "\\(12.0\\text{ min}\\)",
            "\\(17.0\\text{ min}\\)",
            "\\(5.04\\text{ min}\\)",
            "\\(22.0\\text{ min}\\)"
          ],
          "answer": 0,
          "hint": "Use the 87°C measurement to find k; then solve for the total time when T=70°C and subtract 5 minutes.",
          "keyPoints": [
            {
              "text": "87°C after 5 minutes",
              "note": "Substitute this measurement to determine the cooling constant k."
            },
            {
              "text": "How much longer",
              "note": "Find the total time to 70°C, then subtract the 5 minutes already elapsed."
            }
          ],
          "steps": [
            {
              "explain": "Use \\(T(5)=87\\) to find k.",
              "work": "\\(87=21+75e^{-5k}\\Rightarrow e^{-5k}=66/75=0.88\\Rightarrow k=-\\frac15\\ln(0.88)\\approx0.02557\\)"
            },
            {
              "explain": "Solve the model for the total time when T=70.",
              "work": "\\(70=21+75e^{-kt}\\Rightarrow e^{-kt}=49/75\\Rightarrow t=-\\frac{\\ln(49/75)}{k}\\approx17.04\\text{ min}\\)"
            },
            {
              "explain": "Subtract the first five minutes already elapsed.",
              "work": "\\(17.04-5=12.04\\approx12.0\\text{ min more}\\)"
            }
          ],
          "solution": "\\(12.0\\text{ min}\\)",
          "timeLimit": 60,
          "xp": 1,
          "meta": {
            "source": "Abbotsleigh 2020 Trial Examination",
            "sourceFile": "/Users/andrewkim/Downloads/Abbotsleigh 2020.pdf",
            "school": "Abbotsleigh",
            "year": 2020
          }
        }
      ]
