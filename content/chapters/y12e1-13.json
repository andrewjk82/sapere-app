      "title": "Slope fields",
      "questions": [
        {
          "id": "abbotsleigh2020-ext1-q7",
          "type": "mc",
          "difficulty": "medium",
          "stem": "The direction field below represents one of these differential equations. Which equation matches the field?",
          "options": [
            "\\(\\frac{dy}{dx}=\\frac{y-2x}{2y+x}\\)",
            "\\(\\frac{dy}{dx}=\\frac{y-2x}{2y-x}\\)",
            "\\(\\frac{dy}{dx}=\\frac{2y-x}{y+2x}\\)",
            "\\(\\frac{dy}{dx}=\\frac{x-2y}{2y+x}\\)"
          ],
          "answer": 1,
          "hint": "Look for where the direction segments are horizontal (slope 0), then where they are vertical (undefined).",
          "keyPoints": [
            {
              "text": "direction field",
              "note": "A horizontal short segment indicates \\(dy/dx=0\\); vertical segments indicate an undefined slope."
            }
          ],
          "steps": [
            {
              "explain": "In the supplied field, horizontal segments lie along the diagonal through the origin with positive gradient about 2. That means the numerator must vanish when \\(y=2x\\).",
              "work": "\\(\\frac{dy}{dx}=0\\iff y-2x=0\\)",
