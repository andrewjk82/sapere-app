      "title": "Separable differentiable equations",
      "questions": [
        {
          "id": "abbotsleigh2020-ext1-q12b",
          "type": "mc",
          "difficulty": "hard",
          "stem": "Solve \\(\\frac{dy}{dx}=y^2\\cos x\\), given \\(y(\\pi/6)=-\\frac{1}{2}\\).",
          "options": [
            "\\(y=-\\frac1{\\sin x+\\frac32}\\)",
            "\\(y=\\frac1{\\sin x-\\frac32}\\)",
            "\\(y=-\\frac1{\\cos x+\\frac32}\\)",
            "\\(y=-\\sin x-\\frac12\\)"
          ],
          "answer": 0,
          "hint": "Separate the y and x terms, integrate, and use the initial condition to find the constant.",
          "keyPoints": [
            {
              "text": "\\(\\frac{dy}{dx}=y^2\\cos x\\)",
              "note": "Move (1/y^2) beside dy and (\\cos x) beside dx."
            },
            {
              "text": "\\(y(\\pi/6)=-\\frac{1}{2}\\)",
              "note": "Use this value after integrating to determine the constant."
            }
          ],
          "steps": [
            {
              "explain": "Separate variables.",
              "work": "\\(y^{-2}dy=\\cos x,dx\\)"
            },
            {
              "explain": "Integrate both sides.",
              "work": "\\(-\\frac1y=\\sin x+C\\)"
            },
            {
              "explain": "Substitute \\(x=\\pi/6, y=-1/2\\).",
              "work": "\\(2=\\frac{1}{2}+C\\Rightarrow C=\\frac{3}{2}\\)"
            },
            {
              "explain": "Rearrange for y.",
              "work": "\\(\\boxed{y=-\\frac1{\\sin x+\\frac{3}{2}}}\\)"
            }
          ],
          "solution": "\\(y=-\\frac1{\\sin x+\\frac32}\\)",
          "timeLimit": 60,
          "xp": 1,
