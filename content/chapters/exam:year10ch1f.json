        {
          "id": "y10-1f-q1",
          "type": "mc",
          "difficulty": "easy",
          "stem": "The sum of $8000 is borrowed for $4$ years at $7\\%$ p.a. simple interest. How much interest is paid?",
          "options": [
            "\\(2016\\)",
            "\\(1904\\)",
            "\\(2240\\)",
            "\\(2464\\)"
          ],
          "answer": 2,
          "steps": [
            {
              "explain": "Use the simple interest formula \\(I = PRN\\).",
              "work": "I = 8000 \\times 0.07 \\times 4"
            },
            {
              "explain": "Calculate the result.",
              "work": "I = 2240"
            }
          ],
          "timeLimit": 30
        },
        {
          "id": "y10-1f-q2",
          "type": "mc",
          "difficulty": "easy",
          "stem": "The sum of $6000 is borrowed at $8.5\\%$ p.a. simple interest and $1530 is paid in interest. For how many years has the money been borrowed?",
          "options": [
            "\\(5\\)",
            "\\(3\\)",
            "\\(4\\)",
            "\\(2\\)"
          ],
          "answer": 1,
          "steps": [
            {
              "explain": "Use the simple interest formula \\(I = PRN\\).",
              "work": "1530 = 6000 \\times 0.085 \\times N"
            },
            {
              "explain": "Simplify the equation.",
              "work": "1530 = 510 \\times N"
            },
            {
              "explain": "Solve for \\(N\\).",
              "work": "\\(N = \\frac{1530}{510} = 3\\)"
            }
          ],
          "timeLimit": 30
        },
        {
          "id": "y10-1f-q3",
          "type": "mc",
          "difficulty": "easy",
          "stem": "The sum of $9000 is borrowed for $5$ years and $2700 is paid in interest. Calculate the (per annum) rate of simple interest charged, as a percentage.",
          "options": [
            "\\(5\\%\\)",
            "\\(7\\%\\)",
            "\\(6\\%\\)",
            "\\(8\\%\\)"
          ],
          "answer": 2,
          "steps": [
            {
              "explain": "Use the simple interest formula \\(I = PRN\\).",
              "work": "2700 = 9000 \\times R \\times 5"
            },
            {
              "explain": "Simplify.",
              "work": "2700 = 45000 \\times R"
            },
            {
              "explain": "Solve for \\(R\\) as a decimal.",
              "work": "\\(R = \\frac{2700}{45000} = 0.06\\)"
            },
            {
              "explain": "Convert to a percentage.",
              "work": "0.06 \\times 100\\% = 6\\%"
            }
          ],
          "timeLimit": 30
        },
        {
          "id": "y10-1f-q4a",
          "type": "mc",
          "difficulty": "easy",
          "stem": "A department store is offering a $30\\%$ discount on all items in the store. Calculate the discounted price on a jacket with a marked price of $250.",
          "options": [
            "\\(193\\)",
            "\\(175\\)",
            "\\(158\\)",
            "\\(149\\)"
          ],
          "answer": 1,
          "steps": [
            {
              "explain": "Find the multiplier for a \\(30\\%\\) discount.",
              "work": "100\\% - 30\\% = 70\\% = 0.7"
            },
            {
              "explain": "Multiply the marked price by the multiplier.",
              "work": "250 \\times 0.7 = 175"
            }
          ],
          "timeLimit": 30
        },
        {
